<%- include('../partials/header', { title: 'Audit Logs' }) %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
  <div>
    <h1 class="page-title">Audit & Security Logs</h1>
    <p class="page-description">Chronological history of administrative actions for accountability.</p>
  </div>
</div>

<div class="card">
  <% if (logs.length === 0) { %>
    <p style="text-align: center; color: var(--text-muted); padding: 2rem;">No audit logs found.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table" style="font-size: 0.85rem;">
        <thead>
          <tr>
            <th style="width: 15%">Timestamp</th>
            <th style="width: 20%">User</th>
            <th style="width: 20%">Action</th>
            <th style="width: 15%">Entity</th>
            <th style="width: 30%">Details</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td style="white-space: nowrap;"><%= new Date(log.timestamp + 'Z').toLocaleString('en-IN') %></td>
              <td><strong><%= log.user_email %></strong></td>
              <td><span class="badge" style="background: #e0e7ff; color: #4338ca;"><%= log.action %></span></td>
              <td><%= log.entity %> <span style="color: var(--text-muted);">#<%= log.entity_id %></span></td>
              <td><code style="background: #f8fafc; padding: 2px 4px; border-radius: 4px; color: #334155; word-break: break-all;"><%= log.details %></code></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
