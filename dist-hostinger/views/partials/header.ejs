<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Hidden Lamp Payroll</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="app-wrapper">
    <% if (typeof user !== 'undefined' && user) { %>
      <aside class="sidebar">
        <a href="/dashboard" class="brand">
          <img src="/images/logo.png" alt="Hidden Lamp Logo" style="height: 38px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2);">
          <div>
            <span class="brand-title">HIDDEN LAMP</span>
            <span class="brand-subtitle">Payroll Management</span>
          </div>
        </a>

        <nav class="sidebar-nav">
          <a href="/dashboard" class="sidebar-nav-link <%= typeof path !== 'undefined' && path === '/dashboard' ? 'active' : '' %>">
            <i class="fa-solid fa-house"></i> Dashboard
          </a>
          <a href="/employees" class="sidebar-nav-link <%= typeof path !== 'undefined' && path.startsWith('/employees') ? 'active' : '' %>">
            <i class="fa-solid fa-users"></i> Employees
          </a>
          <a href="/payroll" class="sidebar-nav-link <%= typeof path !== 'undefined' && path === '/payroll' ? 'active' : '' %>">
            <i class="fa-solid fa-money-check-dollar"></i> Payroll
          </a>
          <a href="/payslips" class="sidebar-nav-link <%= typeof path !== 'undefined' && path.startsWith('/payslips') ? 'active' : '' %>">
            <i class="fa-solid fa-file-invoice"></i> Payslip
          </a>
          <a href="/expenses" class="sidebar-nav-link <%= typeof path !== 'undefined' && path.startsWith('/expenses') ? 'active' : '' %>">
            <i class="fa-solid fa-receipt"></i> Receipts & Expenses
          </a>
          <a href="/analytics" class="sidebar-nav-link <%= typeof path !== 'undefined' && path.startsWith('/analytics') ? 'active' : '' %>">
            <i class="fa-solid fa-chart-line"></i> Report and Analytics
          </a>
          <a href="/audit-logs" class="sidebar-nav-link <%= typeof path !== 'undefined' && path.startsWith('/audit-logs') ? 'active' : '' %>">
            <i class="fa-solid fa-shield-halved"></i> Audit & Security Logs
          </a>
        </nav>

        <div class="sidebar-footer">
          <div class="upgrade-card">
            <h4><i class="fa-solid fa-rocket" style="margin-bottom: 8px; font-size: 1.5rem; display: block;"></i>System Info</h4>
            <p>Self-Hosted Edition. Secure & encrypted.</p>
          </div>
        </div>
      </aside>

      <main class="main-content">
        <div class="topbar">
          <div class="topbar-search">
            <i class="fa-solid fa-search"></i>
            <input type="text" placeholder="Search now...">
          </div>
          <div class="topbar-profile">
            <div class="user-email">Welcome back, <%= user.email.split('@')[0] %> 👋</div>
            <div class="avatar"><i class="fa-regular fa-user"></i></div>
            <form action="/logout" method="POST" style="margin:0; display:flex;">
              <button type="submit" class="logout-icon"><i class="fa-solid fa-right-from-bracket"></i></button>
            </form>
          </div>
        </div>
        <div class="container">
    <% } else { %>
      <main class="main-content" style="margin-left: 0;">
        <div class="container" style="display:flex; justify-content:center; align-items:center;">
    <% } %>
