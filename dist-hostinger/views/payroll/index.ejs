<%- include('../partials/header', { title: 'Payroll Runs' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Monthly Payroll Calendar & Runs</h1>
    <p class="page-description">Select any month from the interactive calendar to generate or process payroll based on the actual calendar days of that month.</p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<!-- Year Switcher Bar -->
<div class="card" style="padding: 1rem 1.5rem; margin-bottom: 1.5rem;">
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-weight: 700; font-size: 1.1rem; color: var(--text-main);">📅 Calendar Year:</span>
      <a href="/payroll?year=<%= selectedYear - 1 %>" class="btn btn-sm btn-secondary">← <%= selectedYear - 1 %></a>
      <span style="background: var(--accent); color: #fff; padding: 0.35rem 0.85rem; border-radius: 6px; font-weight: 800; font-size: 1rem;"><%= selectedYear %></span>
      <a href="/payroll?year=<%= selectedYear + 1 %>" class="btn btn-sm btn-secondary"><%= selectedYear + 1 %> →</a>
    </div>
    <div style="font-size: 0.875rem; color: var(--text-muted);">
      Click any month card below to launch or open its payroll cycle.
    </div>
  </div>
</div>

<!-- Interactive 12-Month Calendar Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
  <% calendarMonths.forEach(m => { %>
    <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid <%= m.existingRun ? (m.existingRun.status === 'approved' ? '#16a34a' : '#d97706') : '#cbd5e1' %>; <%= m.existingRun && m.existingRun.status === 'approved' ? 'background: #f0fdf4;' : '' %>">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
          <div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin: 0;"><%= m.name %> <%= selectedYear %></h3>
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);"><%= m.daysInMonth %> Days in Month</span>
          </div>
          <% if (m.existingRun) { %>
            <% if (m.existingRun.status === 'approved') { %>
              <span class="badge" style="background: #d1fae5; color: #065f46; font-weight: 800;"><i class="fa-solid fa-circle-check"></i> Completed</span>
            <% } else { %>
              <span class="badge badge-<%= m.existingRun.status %>"><%= m.existingRun.status %></span>
            <% } %>
          <% } else { %>
            <span class="badge" style="background: #f1f5f9; color: #64748b;">Not Started</span>
          <% } %>
        </div>
      </div>

      <div style="margin-top: 1.25rem;">
        <% if (m.existingRun) { %>
          <a href="/payroll/<%= m.existingRun.id %>" class="btn btn-sm btn-secondary" style="width: 100%; justify-content: center;">
            <%= m.existingRun.status === 'approved' ? '📄 View Locked Run' : '⚙️ Process Payroll' %>
          </a>
        <% } else { %>
          <form action="/payroll" method="POST" style="margin: 0;">
            <input type="hidden" name="period" value="<%= m.period %>">
            <input type="hidden" name="pay_date" value="<%= m.lastDay %>">
            <button type="submit" class="btn btn-sm btn-primary" style="width: 100%; justify-content: center;">
              + Start <%= m.name %> Payroll
            </button>
          </form>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>

<!-- Payroll History Table Card -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">All Payroll Runs History</h2>
  </div>

  <% if (runs.length === 0) { %>
    <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No payroll runs created yet. Select a month above to start.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Period</th>
            <th>Pay Date</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% runs.forEach(run => { %>
            <tr>
              <td><strong><%= run.period %></strong></td>
              <td><%= run.pay_date %></td>
              <td>
                <span class="badge badge-<%= run.status %>"><%= run.status %></span>
              </td>
              <td style="text-align: right;">
                <a href="/payroll/<%= run.id %>" class="btn btn-sm btn-secondary">
                  <%= run.status === 'approved' ? '📄 View Locked Run' : '⚙️ Process & Calculate' %>
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
