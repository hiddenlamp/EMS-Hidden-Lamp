<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Hidden Lamp Payroll</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="login-wrapper">
  <div class="login-card">
    <div class="login-header">
      <img src="/images/logo.png" alt="Hidden Lamp Logo" style="height: 60px; border-radius: 10px; margin-bottom: 0.75rem; box-shadow: var(--shadow);">
      <h1 class="login-title">HIDDEN LAMP</h1>
      <p class="login-subtitle">Employee Payroll Management System</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@hiddenlamp.com" required autofocus>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.75rem;">Sign In</button>
    </form>

    <div class="demo-credentials">
      <strong>Demo Account:</strong><br>
      • Admin: <span class="demo-chip" onclick="fillCreds('admin@hiddenlamp.com', 'admin123')">admin@hiddenlamp.com / admin123</span><br>
    </div>
  </div>

  <script>
    function fillCreds(email, pwd) {
      document.getElementById('email').value = email;
      document.getElementById('password').value = pwd;
    }
  </script>
</body>
</html>
