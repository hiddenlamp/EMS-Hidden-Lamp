<%- include('partials/header', { title: title || 'Error' }) %>

<div class="card" style="max-width: 550px; margin: 3rem auto; text-align: center; padding: 2.5rem;">
  <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
  <h2 class="card-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;"><%= title || 'An Error Occurred' %></h2>
  <p style="color: var(--text-muted); margin-bottom: 1.5rem;"><%= message || 'Something went wrong.' %></p>
  <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
  <a href="/dashboard" class="btn btn-primary" style="margin-left: 0.5rem;">Go to Dashboard</a>
</div>

<%- include('partials/footer') %>
