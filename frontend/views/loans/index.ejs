<%- include('../partials/header', { title: 'Loans & Salary Advances', path: '/loans' }) %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="page-title"><i class="fa-solid fa-hand-holding-dollar" style="color: var(--accent);"></i> Employee Loans & Salary Advances</h1>
    <p class="page-description">Manage employee loans, salary advances, monthly EMI deductions, and automatic payroll recovery.</p>
  </div>

  <button type="button" class="btn btn-primary" onclick="document.getElementById('newLoanModal').style.display='flex'" style="font-weight: 700; font-size: 0.9rem;">
    <i class="fa-solid fa-plus-circle"></i> Issue New Loan / Advance
  </button>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
<% } %>

<!-- METRICS OVERVIEW CARDS -->
<div class="metrics-grid">
  <div class="metric-card bg-pastel-purple">
    <div class="metric-icon"><i class="fa-solid fa-money-bill-transfer"></i></div>
    <div>
      <div class="metric-value">₹<%= totalLoansDisbursed.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
      <div class="metric-label">Total Disbursed Loans</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-scale-balanced"></i></div>
    <div>
      <div class="metric-value">₹<%= totalOutstanding.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
      <div class="metric-label">Outstanding Balance</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div>
      <div class="metric-value">₹<%= totalRepaid.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
      <div class="metric-label">Total Amount Recovered</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-yellow">
    <div class="metric-icon"><i class="fa-solid fa-user-clock"></i></div>
    <div>
      <div class="metric-value"><%= activeLoansCount %></div>
      <div class="metric-label">Active Loans & Advances</div>
    </div>
  </div>
</div>

<div class="card" style="padding: 1.25rem;">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <h2 class="card-title"><i class="fa-solid fa-list-check" style="color: var(--accent);"></i> Employee Loan Accounts</h2>
  </div>

  <% if (loans.length === 0) { %>
    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
      <i class="fa-solid fa-hand-holding-hand" style="font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.5;"></i>
      <p style="font-size: 0.95rem; font-weight: 600; color: #475569;">No active or past employee loans found.</p>
      <button type="button" class="btn btn-primary" onclick="document.getElementById('newLoanModal').style.display='flex'" style="margin-top: 0.75rem; font-size: 0.85rem;">
        Issue First Loan / Advance
      </button>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table" style="width: 100%;">
        <thead>
          <tr>
            <th style="white-space: nowrap;">Employee Name</th>
            <th style="white-space: nowrap;">Loan Type</th>
            <th style="text-align: right; white-space: nowrap;">Sanctioned Loan</th>
            <th style="text-align: right; white-space: nowrap;">Monthly EMI</th>
            <th style="text-align: right; white-space: nowrap;">Recovered</th>
            <th style="text-align: right; white-space: nowrap;">Balance Due</th>
            <th style="white-space: nowrap;">Disbursed Date</th>
            <th style="text-align: center; white-space: nowrap;">Status</th>
            <th style="text-align: right; white-space: nowrap;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% loans.forEach(l => { %>
            <tr>
              <td style="white-space: nowrap; vertical-align: middle;">
                <strong style="font-size: 0.92rem; color: #0f172a;"><%= l.employee_name %></strong>
                <br><small style="color: #64748b; font-weight: 500;"><%= l.employee_code || ('ID #' + l.employee_id) %> • <%= l.work_location %></small>
              </td>
              <td style="white-space: nowrap; vertical-align: middle;">
                <span class="badge" style="background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-size: 0.78rem;">
                  <%= l.loan_type %>
                </span>
              </td>
              <td style="text-align: right; font-weight: 700; color: #0f172a; white-space: nowrap; vertical-align: middle;">
                ₹<%= l.loan_amount.toLocaleString('en-IN') %>
              </td>
              <td style="text-align: right; font-weight: 700; color: #2563eb; white-space: nowrap; vertical-align: middle;">
                ₹<%= l.monthly_emi.toLocaleString('en-IN') %>
              </td>
              <td style="text-align: right; font-weight: 700; color: #059669; white-space: nowrap; vertical-align: middle;">
                ₹<%= l.repaid_amount.toLocaleString('en-IN') %>
              </td>
              <td style="text-align: right; font-weight: 800; color: <%= l.remaining_balance > 0 ? '#dc2626' : '#15803d' %>; white-space: nowrap; vertical-align: middle;">
                ₹<%= l.remaining_balance.toLocaleString('en-IN') %>
              </td>
              <td style="white-space: nowrap; vertical-align: middle; font-size: 0.85rem; color: #475569;">
                <%= l.disbursed_date %>
              </td>
              <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                <% if (l.status === 'Active') { %>
                  <span class="badge" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #93c5fd; font-size: 0.75rem;">
                    <i class="fa-solid fa-spinner fa-spin"></i> Active
                  </span>
                <% } else if (l.status === 'Completed') { %>
                  <span class="badge" style="background: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 0.75rem;">
                    <i class="fa-solid fa-circle-check"></i> Completed
                  </span>
                <% } else { %>
                  <span class="badge" style="background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; font-size: 0.75rem;">
                    Cancelled
                  </span>
                <% } %>
              </td>
              <td style="text-align: right; white-space: nowrap; vertical-align: middle;">
                <div style="display: flex; gap: 0.35rem; justify-content: flex-end;">
                  <% if (l.status === 'Active' && l.remaining_balance > 0) { %>
                    <button type="button" class="btn btn-sm btn-primary" onclick="openRepayModal('<%= l.id %>', '<%= l.employee_name %>', '<%= l.remaining_balance %>')" style="padding: 0.25rem 0.5rem; font-size: 0.78rem;" title="Record Manual Payment">
                      <i class="fa-solid fa-hand-holding-hand"></i> Repay
                    </button>
                  <% } %>

                  <form action="/loans/<%= l.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this loan record?');" style="display: inline; margin: 0;">
                    <button type="submit" class="btn btn-sm btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.78rem; color: #dc2626; border-color: #fca5a5;" title="Delete Record">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ISSUE NEW LOAN / ADVANCE MODAL -->
<div id="newLoanModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #ffffff; width: 90%; max-width: 500px; border-radius: 16px; padding: 1.75rem; box-shadow: var(--shadow-xl); border: 1px solid var(--border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #0f172a;">
        <i class="fa-solid fa-hand-holding-dollar" style="color: var(--accent);"></i> Issue Loan / Salary Advance
      </h3>
      <button type="button" onclick="document.getElementById('newLoanModal').style.display='none'" style="background: none; border: none; font-size: 1.2rem; color: #64748b; cursor: pointer;">✖</button>
    </div>

    <form action="/loans" method="POST">
      <div style="margin-bottom: 1rem;">
        <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Select Employee *</label>
        <select name="employee_id" class="form-control" required>
          <option value="">-- Choose Employee --</option>
          <% employees.forEach(e => { %>
            <option value="<%= e.id %>"><%= e.name %> (<%= e.work_location %>)</option>
          <% }); %>
        </select>
      </div>

      <div style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
        <div style="flex: 1;">
          <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Loan Type *</label>
          <select name="loan_type" class="form-control" required>
            <option value="Salary Advance">Salary Advance</option>
            <option value="Personal Loan">Personal Loan</option>
            <option value="Emergency Loan">Emergency Loan</option>
            <option value="Equipment Loan">Equipment Loan</option>
          </select>
        </div>

        <div style="flex: 1;">
          <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Disbursed Date *</label>
          <input type="date" name="disbursed_date" class="form-control" value="<%= new Date().toISOString().substring(0, 10) %>" required>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
        <div style="flex: 1;">
          <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Total Loan Amount (₹) *</label>
          <input type="number" step="1" name="loan_amount" class="form-control" placeholder="e.g. 10000" required>
        </div>

        <div style="flex: 1;">
          <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Monthly EMI Deduction (₹) *</label>
          <input type="number" step="1" name="monthly_emi" class="form-control" placeholder="e.g. 2000" required>
        </div>
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Notes / Reason</label>
        <textarea name="notes" class="form-control" rows="2" placeholder="Emergency advance, personal request..."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('newLoanModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary" style="font-weight: 700;"><i class="fa-solid fa-check-circle"></i> Disburse Loan</button>
      </div>
    </form>
  </div>
</div>

<!-- MANUAL REPAYMENT MODAL -->
<div id="repayModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #ffffff; width: 90%; max-width: 420px; border-radius: 16px; padding: 1.5rem; box-shadow: var(--shadow-xl); border: 1px solid var(--border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: #0f172a;">
        <i class="fa-solid fa-hand-holding-hand" style="color: var(--accent);"></i> Record Loan Repayment
      </h3>
      <button type="button" onclick="document.getElementById('repayModal').style.display='none'" style="background: none; border: none; font-size: 1.2rem; color: #64748b; cursor: pointer;">✖</button>
    </div>

    <form id="repayForm" method="POST">
      <p style="font-size: 0.88rem; color: #475569; margin-bottom: 1rem;">
        Recording manual cash/bank repayment for <strong id="repayEmpName">Employee</strong>.<br>
        Current Balance Due: <strong id="repayBalance" style="color: #dc2626;">₹0</strong>
      </p>

      <div style="margin-bottom: 1rem;">
        <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Repayment Amount (₹) *</label>
        <input type="number" step="1" name="amount" id="repayAmountInput" class="form-control" required>
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label style="font-size: 0.82rem; font-weight: 700; color: #475569; display: block; margin-bottom: 0.35rem;">Notes</label>
        <input type="text" name="notes" class="form-control" placeholder="Direct Bank Transfer / Cash...">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('repayModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary" style="font-weight: 700;">Record Repayment</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRepayModal(loanId, empName, balance) {
    document.getElementById('repayForm').action = '/loans/' + loanId + '/repay';
    document.getElementById('repayEmpName').innerText = empName;
    document.getElementById('repayBalance').innerText = '₹' + Number(balance).toLocaleString('en-IN');
    document.getElementById('repayAmountInput').value = balance;
    document.getElementById('repayModal').style.display = 'flex';
  }
</script>

<%- include('../partials/footer') %>
