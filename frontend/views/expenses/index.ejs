<%- include('../partials/header', { title: 'Corporate Receipts & Project Expenses', path: '/expenses' }) %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="page-title">Corporate Receipts & Project Expenses</h1>
    <p class="page-description">Track city-wise project site expenses, vendor receipts, employee field claims, and company overhead.</p>
  </div>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/expenses/report" class="btn btn-secondary">
      <i class="fa-solid fa-file-csv"></i> Download CSV Report
    </a>
    <a href="/expenses/company/new" class="btn btn-secondary">
      <i class="fa-solid fa-building-circle-check"></i> + Project / Company Expense
    </a>
    <a href="/expenses/travel/new" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> + Add Field Expense Claim
    </a>
  </div>
</div>

<% if (success) { %>
  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
<% } %>

<!-- Summary Metric KPI Cards -->
<div class="metrics-grid">
  <div class="metric-card bg-pastel-orange">
    <div class="metric-icon"><i class="fa-solid fa-building-user"></i></div>
    <div>
      <div class="metric-value">₹<%= totalCompanyExpenses.toLocaleString('en-IN') %></div>
      <div class="metric-label">Project Site & Company Expenses</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-plane-up"></i></div>
    <div>
      <div class="metric-value">₹<%= totalTravelClaims.toLocaleString('en-IN') %></div>
      <div class="metric-label">Employee Field Claims</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
    <div>
      <div class="metric-value">₹<%= totalAdvancePaid.toLocaleString('en-IN') %></div>
      <div class="metric-label">Total Advance / Paid</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-red" style="background: #fff1f2; border-color: #fecdd3;">
    <div class="metric-icon" style="background: #ffe4e6; color: #e11d48;"><i class="fa-solid fa-scale-unbalanced"></i></div>
    <div>
      <div class="metric-value" style="color: #be123c;">₹<%= totalPendingDues.toLocaleString('en-IN') %></div>
      <div class="metric-label" style="color: #9f1239;">Total Accrued Balance Dues</div>
    </div>
  </div>
</div>

<!-- Tab Navigation Header & Filters -->
<div class="card" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <!-- Tabs Switcher -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/expenses?tab=company&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'company' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600;">
        <i class="fa-solid fa-landmark"></i> Company & Project Receipts (<%= companyExpenses.length %>)
      </a>
      <a href="/expenses?tab=projects&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'projects' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600;">
        <i class="fa-solid fa-diagram-project"></i> Project-Wise Breakdown (<%= projectSummary.length %>)
      </a>
      <a href="/expenses?tab=travel&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'travel' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600;">
        <i class="fa-solid fa-users-gear"></i> Employee Field Claims (<%= travelExpenses.length %>)
      </a>
    </div>

    <!-- Filter Dropdowns -->
    <form method="GET" action="/expenses" style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
      <input type="hidden" name="tab" value="<%= activeTab %>">
      
      <select name="project" class="form-control" onchange="this.form.submit()" style="min-width: 170px;">
        <option value="all" <%= projectFilter === 'all' ? 'selected' : '' %>>🏗️ All Projects</option>
        <% projects.forEach(proj => { %>
          <option value="<%= proj %>" <%= projectFilter === proj ? 'selected' : '' %>><%= proj %></option>
        <% }); %>
      </select>

      <select name="location" class="form-control" onchange="this.form.submit()" style="min-width: 150px;">
        <option value="all" <%= locationFilter === 'all' ? 'selected' : '' %>>📍 All Cities</option>
        <% locations.forEach(loc => { %>
          <option value="<%= loc %>" <%= locationFilter === loc ? 'selected' : '' %>><%= loc %></option>
        <% }); %>
      </select>

      <select name="employee" class="form-control" onchange="this.form.submit()" style="min-width: 170px;">
        <option value="all" <%= employeeFilter === 'all' ? 'selected' : '' %>>👤 All Employees</option>
        <% employees.forEach(emp => { %>
          <option value="<%= emp.id %>" <%= String(employeeFilter) === String(emp.id) ? 'selected' : '' %>><%= emp.name %> (<%= emp.employee_code %>)</option>
        <% }); %>
      </select>

      <% if (activeTab === 'travel') { %>
        <select name="status" class="form-control" onchange="this.form.submit()" style="min-width: 140px;">
          <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>⚡ All Claims</option>
          <option value="Pending" <%= statusFilter === 'Pending' ? 'selected' : '' %>>🔴 Dues Pending</option>
          <option value="Reimbursed" <%= statusFilter === 'Reimbursed' ? 'selected' : '' %>>🟢 Fully Settled</option>
        </select>
      <% } %>
    </form>
  </div>
</div>

<% if (selectedEmployeeInfo && activeTab === 'travel') { %>
  <!-- EMPLOYEE TRAVEL PROFILE CARD -->
  <div class="card" style="margin-bottom: 1.5rem; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #fff; border-radius: 12px; padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 52px; height: 52px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #38bdf8;">
          <i class="fa-solid fa-user-gear"></i>
        </div>
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; color: #ffffff;"><%= selectedEmployeeInfo.name %></h2>
          <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 0.2rem;">
            Code: <strong style="color: #38bdf8;"><%= selectedEmployeeInfo.employee_code %></strong> | 
            Designation: <%= selectedEmployeeInfo.designation || 'Staff' %> | 
            Location: <span style="background: rgba(255,255,255,0.15); padding: 0.1rem 0.4rem; border-radius: 4px; color: #fff;"><%= selectedEmployeeInfo.work_location %></span>
          </div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/expenses/travel/new?employee_id=<%= selectedEmployeeInfo.id %>" class="btn btn-primary" style="background: #2563eb; border: none; font-weight: 600;">
          <i class="fa-solid fa-plus"></i> + Add Expense Claim
        </a>
        <a href="/expenses/employee-ledger/<%= selectedEmployeeInfo.id %>" class="btn btn-secondary" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.2);">
          <i class="fa-solid fa-address-book"></i> View Full Ledger
        </a>
        <a href="/expenses?tab=travel" class="btn btn-secondary" style="background: rgba(255,255,255,0.1); color: #94a3b8; border: 1px solid rgba(255,255,255,0.15);">
          <i class="fa-solid fa-xmark"></i> Clear Filter
        </a>
      </div>
    </div>
  </div>
<% } %>

<% if (activeTab === 'company') { %>
  <!-- TAB 1: COMPANY & PROJECT SITE EXPENSES -->
  <div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2 class="card-title"><i class="fa-solid fa-building-user" style="color: var(--accent);"></i> Project Site & Corporate Overhead (<%= companyExpenses.length %> Receipts)</h2>
      <a href="/expenses/company/new" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-plus"></i> + Add Expense Receipt
      </a>
    </div>

    <% if (companyExpenses.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted); font-size: 1rem;">No company or project operational expenses recorded for selected filter.</p>
      </div>
    <% } else { %>
      <!-- Desktop Table View (>= 768px) -->
      <div class="desktop-table-container">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Project & City Location</th>
                <th>Title, Category & Vendor</th>
                <th>Amount (₹)</th>
                <th>Date</th>
                <th>Payment Mode</th>
                <th>Status</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% companyExpenses.forEach(exp => { %>
                <tr>
                  <td>
                    <span style="background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.55rem; border-radius: 4px; font-weight: 700; font-size: 0.8rem;">
                      🏗️ <%= exp.project_name || 'General Corporate' %>
                    </span>
                    <br><small style="color: var(--text-muted);"><i class="fa-solid fa-location-dot"></i> <%= exp.work_location %></small>
                  </td>
                  <td>
                    <strong style="font-size: 0.95rem; color: #0f172a;"><%= exp.title %></strong>
                    <div style="margin-top: 0.25rem; display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
                      <span style="background: #f1f5f9; color: #334155; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                        <%= exp.category %>
                      </span>
                      <% if (exp.vendor_name) { %>
                        <span style="background: #fef3c7; color: #92400e; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                          🏢 <%= exp.vendor_name %>
                        </span>
                      <% } %>
                      <% if (exp.invoice_ref) { %>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Ref: <strong><%= exp.invoice_ref %></strong></span>
                      <% } %>
                    </div>
                  </td>
                  <td><strong style="font-size: 1.05rem; color: #0f172a;">₹<%= exp.amount.toLocaleString('en-IN') %></strong></td>
                  <td><div style="font-weight: 600;"><%= exp.date %></div></td>
                  <td><div style="font-weight: 600; font-size: 0.85rem; color: #334155;">💳 <%= exp.payment_mode %></div></td>
                  <td>
                    <% if (exp.payment_status === 'Paid') { %>
                      <span class="badge badge-approved" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">🟢 Paid</span>
                    <% } else { %>
                      <span class="badge badge-danger" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;">🔴 Unpaid / Pending</span>
                    <% } %>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <% if (exp.payment_status !== 'Paid') { %>
                      <a href="/expenses/company/<%= exp.id %>/pay" class="btn btn-sm btn-primary" style="background: #059669; border-color: #059669; padding: 0.25rem 0.55rem; font-size: 0.75rem; margin-right: 0.3rem;">
                        <i class="fa-solid fa-circle-check"></i> Mark Paid
                      </a>
                    <% } %>

                    <form action="/expenses/company/<%= exp.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this expense record?');">
                      <button type="submit" class="btn btn-sm btn-secondary" style="color: #dc2626; padding: 0.25rem 0.5rem; font-size: 0.75rem;" title="Delete Record">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Mobile Stacked Cards View (< 768px) -->
      <div class="mobile-cards-container">
        <% companyExpenses.forEach(exp => { %>
          <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem; margin-bottom: 1rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.6rem;">
              <div>
                <span style="background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.55rem; border-radius: 4px; font-weight: 700; font-size: 0.78rem;">
                  🏗️ <%= exp.project_name || 'General Corporate' %>
                </span>
                <div style="font-weight: 800; font-size: 1.05rem; color: #0f172a; margin-top: 0.35rem;"><%= exp.title %></div>
              </div>
              <span class="badge" style="<%= exp.payment_status === 'Paid' ? 'background: #ecfdf5; color: #047857;' : 'background: #fff1f2; color: #be123c;' %>">
                <%= exp.payment_status === 'Paid' ? '🟢 Paid' : '🔴 Unpaid' %>
              </span>
            </div>

            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
              <span style="background: #f1f5f9; color: #334155; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                📍 <%= exp.work_location %>
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                🏷️ <%= exp.category %>
              </span>
              <% if (exp.vendor_name) { %>
                <span style="background: #fef3c7; color: #92400e; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                  🏢 <%= exp.vendor_name %>
                </span>
              <% } %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.65rem 0.85rem; border-radius: 8px; margin-bottom: 0.85rem;">
              <div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Amount</div>
                <div style="font-size: 1.15rem; font-weight: 800; color: #0f172a;">₹<%= exp.amount.toLocaleString('en-IN') %></div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 0.75rem; color: var(--text-muted);">Date / Mode</div>
                <div style="font-size: 0.85rem; font-weight: 600; color: #334155;"><%= exp.date %> (💳 <%= exp.payment_mode %>)</div>
              </div>
            </div>

            <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
              <% if (exp.payment_status !== 'Paid') { %>
                <a href="/expenses/company/<%= exp.id %>/pay" class="btn btn-sm btn-primary" style="background: #059669; border-color: #059669; flex: 1; justify-content: center;">
                  <i class="fa-solid fa-circle-check"></i> Mark Paid
                </a>
              <% } %>
              <form action="/expenses/company/<%= exp.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this expense record?');">
                <button type="submit" class="btn btn-sm btn-secondary" style="color: #dc2626;" title="Delete Record">
                  <i class="fa-solid fa-trash-can"></i> Delete
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

<% } else if (activeTab === 'projects') { %>
  <!-- TAB 2: PROJECT-WISE EXPENSE SUMMARY & CITY BREAKDOWN -->
  <div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2 class="card-title"><i class="fa-solid fa-diagram-project" style="color: var(--accent);"></i> Project-Wise Expense & City Breakdown (<%= projectSummary.length %> Active Projects)</h2>
      <a href="/expenses/company/new" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-plus"></i> + Add Project Expense
      </a>
    </div>

    <% if (projectSummary.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-city" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted); font-size: 1rem;">No project site expenses recorded yet.</p>
      </div>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
        <% projectSummary.forEach(proj => { %>
          <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <span style="background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.55rem; border-radius: 4px; font-weight: 700; font-size: 0.8rem;">
                  📍 <%= proj.work_location %>
                </span>
                <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin-top: 0.35rem; margin-bottom: 0.1rem;"><%= proj.project_name %></h3>
              </div>
              <span style="background: #f1f5f9; color: #334155; font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 9999px;">
                <%= proj.count %> Receipts
              </span>
            </div>

            <div style="margin-top: 1rem; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.85rem 1rem; border-radius: 8px;">
              <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Total Project Expenditure</div>
              <div style="font-size: 1.5rem; font-weight: 800; color: #2563eb; margin-top: 0.2rem;">₹<%= proj.total_spent.toLocaleString('en-IN') %></div>
            </div>

            <div style="margin-top: 0.85rem; text-align: right;">
              <a href="/expenses?tab=company&project=<%= encodeURIComponent(proj.project_name) %>" class="btn btn-sm btn-secondary" style="font-size: 0.78rem;">
                <i class="fa-solid fa-list-check"></i> View Project Receipts
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

<% } else { %>
  <!-- TAB 3: CONSOLIDATED EMPLOYEE EXPENSE & REIMBURSEMENT SUMMARY TABLE -->
  <div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2 class="card-title">
        <i class="fa-solid fa-address-book" style="color: var(--accent);"></i> 
        <% if (selectedEmployeeInfo) { %>
          Expense Ledger Summary for <%= selectedEmployeeInfo.name %>
        <% } else { %>
          Employee Field & Travel Claims (<%= travelExpenses.length %> Employees)
        <% } %>
      </h2>
      <a href="/expenses/travel/new" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-plus"></i> + Add Field Claim
      </a>
    </div>

    <% if (travelExpenses.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-plane-slash" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted); font-size: 1rem;">No employee field expense claims found for selected filter.</p>
      </div>
    <% } else { %>
      <!-- Desktop View (>= 768px) -->
      <div class="desktop-table-container">
        <div class="table-responsive">
          <table class="table" style="font-size: 0.9rem;">
            <thead>
              <tr>
                <th>Employee Info</th>
                <th>Claims Filed</th>
                <th>Total Claimed (₹)</th>
                <th>Total Paid / Adv (₹)</th>
                <th>Net Accrued Dues (₹)</th>
                <th>Status Summary</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% travelExpenses.forEach(empRecord => { %>
                <tr>
                  <td>
                    <strong><%= empRecord.employee_name %></strong>
                    <br><small style="color: var(--text-muted); font-family: monospace;"><%= empRecord.employee_code %></small>
                    <br><span style="background: #f1f5f9; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;"><%= empRecord.emp_location %></span>
                  </td>
                  <td>
                    <strong style="font-size: 0.95rem; color: #0f172a;"><%= empRecord.claim_count %> Claims</strong>
                    <br><small style="color: var(--text-muted);">Latest: <%= empRecord.latest_date %></small>
                  </td>
                  <td>
                    <strong style="font-size: 1rem; color: #0f172a;">₹<%= empRecord.total_amount.toLocaleString('en-IN') %></strong>
                  </td>
                  <td>
                    <strong style="font-size: 0.95rem; color: #047857;">₹<%= empRecord.advance_paid.toLocaleString('en-IN') %></strong>
                  </td>
                  <td>
                    <strong style="font-size: 1.05rem; color: <%= empRecord.dues_amount > 0 ? '#b91c1c' : '#059669' %>;">
                      ₹<%= empRecord.dues_amount.toLocaleString('en-IN') %>
                    </strong>
                  </td>
                  <td>
                    <% if (empRecord.dues_amount > 0) { %>
                      <span class="badge badge-danger" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;">🔴 Payment Pending</span>
                    <% } else { %>
                      <span class="badge badge-approved" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">🟢 Fully Settled</span>
                    <% } %>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a href="/expenses/employee-ledger/<%= empRecord.employee_id %>" class="btn btn-sm btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.78rem;">
                      <i class="fa-solid fa-eye"></i> View Full Ledger
                    </a>
                    <a href="/expenses/travel/new?employee_id=<%= empRecord.employee_id %>" class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.5rem; font-size: 0.78rem;">
                      <i class="fa-solid fa-plus"></i> + Add Claim
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Mobile Stacked Cards View (< 768px) -->
      <div class="mobile-cards-container">
        <% travelExpenses.forEach(empRecord => { %>
          <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem; margin-bottom: 1rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.6rem;">
              <div>
                <div style="font-weight: 800; font-size: 1.1rem; color: #0f172a;"><%= empRecord.employee_name %></div>
                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= empRecord.employee_code %> | 📍 <%= empRecord.emp_location %></div>
              </div>
              <span class="badge" style="<%= empRecord.dues_amount > 0 ? 'background: #fff1f2; color: #be123c;' : 'background: #ecfdf5; color: #047857;' %>">
                <%= empRecord.dues_amount > 0 ? '🔴 Pending Dues' : '🟢 Settled' %>
              </span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.75rem; border-radius: 8px; margin-bottom: 0.85rem;">
              <div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Total Claimed</div>
                <div style="font-size: 1.05rem; font-weight: 800; color: #0f172a;">₹<%= empRecord.total_amount.toLocaleString('en-IN') %></div>
              </div>
              <div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Remaining Dues</div>
                <div style="font-size: 1.05rem; font-weight: 800; color: <%= empRecord.dues_amount > 0 ? '#b91c1c' : '#059669' %>;">₹<%= empRecord.dues_amount.toLocaleString('en-IN') %></div>
              </div>
            </div>

            <div style="display: flex; gap: 0.5rem;">
              <a href="/expenses/employee-ledger/<%= empRecord.employee_id %>" class="btn btn-sm btn-primary" style="flex: 1; justify-content: center;">
                <i class="fa-solid fa-eye"></i> View Ledger
              </a>
              <a href="/expenses/travel/new?employee_id=<%= empRecord.employee_id %>" class="btn btn-sm btn-secondary" style="flex: 1; justify-content: center;">
                <i class="fa-solid fa-plus"></i> + Add Claim
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
