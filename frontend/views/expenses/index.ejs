<script>
function openModal(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'flex';
}
function closeModal(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'none';
}

function openSettleCompanyBillModal(expId, title, amount) {
  document.getElementById('settleCompanyForm').action = '/expenses/company/' + expId + '/pay';
  document.getElementById('c_bill_title').innerText = title;
  document.getElementById('c_bill_amount').innerText = '₹' + amount.toLocaleString('en-IN');
  openModal('settleCompanyBillModal');
}

function openPayModal(claimId, empName, dues, total, advance) {
  document.getElementById('settleForm').action = '/expenses/travel/' + claimId + '/status';
  document.getElementById('p_emp_name').innerText = empName;
  document.getElementById('p_total_amount').innerText = '₹' + total.toLocaleString('en-IN');
  document.getElementById('p_advance_paid').innerText = '₹' + advance.toLocaleString('en-IN');
  document.getElementById('p_dues_amount').innerText = '₹' + dues.toLocaleString('en-IN');
  
  document.getElementById('p_payment_amount').value = dues;
  document.getElementById('p_payment_amount').max = dues;

  openModal('settlePaymentModal');
}

function toggleClaimTypeFields() {
  const type = document.getElementById('claim_type_select').value;
  const isTravel = type === 'Travel';

  document.getElementById('fields_travel_route').style.display = isTravel ? 'grid' : 'none';
  document.getElementById('fields_travel_breakdown').style.display = isTravel ? 'block' : 'none';
  document.getElementById('field_end_date').style.display = isTravel ? 'block' : 'none';

  document.getElementById('field_item_title').style.display = isTravel ? 'none' : 'block';
  document.getElementById('field_direct_amount').style.display = isTravel ? 'none' : 'block';

  calculateClaimTotals();
}

function calculateClaimTotals() {
  const type = document.getElementById('claim_type_select').value;
  let total = 0;

  if (type === 'Travel') {
    const t = parseFloat(document.getElementById('t_travel').value) || 0;
    const f = parseFloat(document.getElementById('t_food').value) || 0;
    const s = parseFloat(document.getElementById('t_stay').value) || 0;
    const m = parseFloat(document.getElementById('t_misc').value) || 0;
    total = t + f + s + m;
  } else {
    total = parseFloat(document.getElementById('t_direct_total').value) || 0;
  }

  const adv = parseFloat(document.getElementById('t_advance').value) || 0;
  const dues = Math.max(0, total - adv);

  document.getElementById('disp_total').innerText = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
  document.getElementById('disp_dues').innerText = '₹' + dues.toLocaleString('en-IN', { minimumFractionDigits: 2 });
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.calc-trigger').forEach(input => {
    input.addEventListener('input', calculateClaimTotals);
  });
});
</script>

