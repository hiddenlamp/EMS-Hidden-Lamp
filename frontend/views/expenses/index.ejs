<%- include('../partials/header', { title: 'Corporate Receipts & Project Expenses', path: '/expenses' }) %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="page-title">Corporate Receipts & Project Expenses</h1>
    <p class="page-description">Track city-wise project site expenses, company operational overhead bills, vendor receipts, and employee field claims.</p>
  </div>
  <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
    <a href="/expenses/report" class="btn btn-secondary">
      <i class="fa-solid fa-file-csv"></i> Download CSV Report
    </a>
    <a href="/expenses/project/new" class="btn btn-primary" style="background: #2563eb; border-color: #2563eb; font-weight: 700;">
      <i class="fa-solid fa-diagram-project"></i> + Project Site Expense
    </a>
    <a href="/expenses/company/new" class="btn btn-secondary" style="background: #ecfdf5; color: #047857; border-color: #a7f3d0; font-weight: 700;">
      <i class="fa-solid fa-landmark"></i> + Company Overhead Bill
    </a>
    <a href="/expenses/travel/new" class="btn btn-secondary" style="font-weight: 600;">
      <i class="fa-solid fa-user-shield"></i> + Field Expense Claim
    </a>
  </div>
</div>

<% if (success) { %>
  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
<% } %>

<!-- Summary Metric KPI Cards -->
<div class="metrics-grid">
  <div class="metric-card bg-pastel-orange">
    <div class="metric-icon"><i class="fa-solid fa-diagram-project"></i></div>
    <div>
      <div class="metric-value">₹<%= totalProjectExpenses.toLocaleString('en-IN') %></div>
      <div class="metric-label">Project Site Expenses</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-landmark"></i></div>
    <div>
      <div class="metric-value">₹<%= totalCompanyExpenses.toLocaleString('en-IN') %></div>
      <div class="metric-label">Company Operational Overhead</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-plane-up"></i></div>
    <div>
      <div class="metric-value">₹<%= totalTravelClaims.toLocaleString('en-IN') %></div>
      <div class="metric-label">Employee Field Claims</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-red" style="background: #fff1f2; border-color: #fecdd3;">
    <div class="metric-icon" style="background: #ffe4e6; color: #e11d48;"><i class="fa-solid fa-scale-unbalanced"></i></div>
    <div>
      <div class="metric-value" style="color: #be123c;">₹<%= totalPendingDues.toLocaleString('en-IN') %></div>
      <div class="metric-label" style="color: #9f1239;">Total Accrued Balance Dues</div>
    </div>
  </div>
</div>

<!-- Tab Navigation Header & Filters -->
<div class="card" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <!-- Tabs Switcher -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/expenses?tab=projects&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'projects' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 700;">
        <i class="fa-solid fa-diagram-project"></i> 🏗️ Project Site Expenses (<%= projectSummary.length %> Projects)
      </a>
      <a href="/expenses?tab=company&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'company' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 700;">
        <i class="fa-solid fa-landmark"></i> 🏢 Company Operational Overhead (<%= companyExpenses.length %> Bills)
      </a>
      <a href="/expenses?tab=travel&status=<%= statusFilter %>&location=<%= locationFilter %>&project=<%= projectFilter %>&employee=<%= employeeFilter %>" class="btn <%= activeTab === 'travel' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 700;">
        <i class="fa-solid fa-users-gear"></i> 👤 Employee Field Claims (<%= travelExpenses.length %>)
      </a>
    </div>

    <!-- Filter Dropdowns -->
    <form method="GET" action="/expenses" style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
      <input type="hidden" name="tab" value="<%= activeTab %>">
      
      <% if (activeTab === 'projects') { %>
        <select name="project" class="form-control" onchange="this.form.submit()" style="min-width: 170px;">
          <option value="all" <%= projectFilter === 'all' ? 'selected' : '' %>>🏗️ All Projects</option>
          <% projects.forEach(proj => { %>
            <option value="<%= proj %>" <%= projectFilter === proj ? 'selected' : '' %>><%= proj %></option>
          <% }); %>
        </select>
      <% } %>

      <select name="location" class="form-control" onchange="this.form.submit()" style="min-width: 150px;">
        <option value="all" <%= locationFilter === 'all' ? 'selected' : '' %>>📍 All Cities</option>
        <% locations.forEach(loc => { %>
          <option value="<%= loc %>" <%= locationFilter === loc ? 'selected' : '' %>><%= loc %></option>
        <% }); %>
      </select>

      <select name="employee" class="form-control" onchange="this.form.submit()" style="min-width: 170px;">
        <option value="all" <%= employeeFilter === 'all' ? 'selected' : '' %>>👤 All Staff In-Charge</option>
        <% employees.forEach(emp => { %>
          <option value="<%= emp.id %>" <%= String(employeeFilter) === String(emp.id) ? 'selected' : '' %>><%= emp.name %> (<%= emp.employee_code %>)</option>
        <% }); %>
      </select>

      <% if (activeTab === 'travel') { %>
        <select name="status" class="form-control" onchange="this.form.submit()" style="min-width: 140px;">
          <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>⚡ All Claims</option>
          <option value="Pending" <%= statusFilter === 'Pending' ? 'selected' : '' %>>🔴 Dues Pending</option>
          <option value="Reimbursed" <%= statusFilter === 'Reimbursed' ? 'selected' : '' %>>🟢 Fully Settled</option>
        </select>
      <% } %>
    </form>
  </div>
</div>

<% if (selectedEmployeeInfo && activeTab === 'travel') { %>
  <!-- EMPLOYEE TRAVEL PROFILE CARD -->
  <div class="card" style="margin-bottom: 1.5rem; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #fff; border-radius: 12px; padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 52px; height: 52px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #38bdf8;">
          <i class="fa-solid fa-user-gear"></i>
        </div>
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; color: #ffffff;"><%= selectedEmployeeInfo.name %></h2>
          <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 0.2rem;">
            Code: <strong style="color: #38bdf8;"><%= selectedEmployeeInfo.employee_code %></strong> | 
            Designation: <%= selectedEmployeeInfo.designation || 'Staff' %> | 
            Location: <span style="background: rgba(255,255,255,0.15); padding: 0.1rem 0.4rem; border-radius: 4px; color: #fff;"><%= selectedEmployeeInfo.work_location %></span>
          </div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/expenses/travel/new?employee_id=<%= selectedEmployeeInfo.id %>" class="btn btn-primary" style="background: #2563eb; border: none; font-weight: 600;">
          <i class="fa-solid fa-plus"></i> + Add Expense Claim
        </a>
        <a href="/expenses/employee-ledger/<%= selectedEmployeeInfo.id %>" class="btn btn-secondary" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.2);">
          <i class="fa-solid fa-address-book"></i> View Full Ledger
        </a>
        <a href="/expenses?tab=travel" class="btn btn-secondary" style="background: rgba(255,255,255,0.1); color: #94a3b8; border: 1px solid rgba(255,255,255,0.15);">
          <i class="fa-solid fa-xmark"></i> Clear Filter
        </a>
      </div>
    </div>
  </div>
<% } %>

<% if (activeTab === 'projects') { %>
  <!-- TAB 1: DEDICATED PROJECT SITE EXPENSES & HEADINGS -->
  <% if (projectSummary.length === 0) { %>
    <div class="card" style="text-align: center; padding: 3rem 1rem;">
      <i class="fa-solid fa-city" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
      <p style="color: var(--text-muted); font-size: 1rem;">No project site expenses recorded yet.</p>
      <a href="/expenses/project/new" class="btn btn-primary" style="margin-top: 1rem;">
        <i class="fa-solid fa-plus"></i> + Create First Project Expense
      </a>
    </div>
  <% } else { %>
    <% projectSummary.forEach(proj => { %>
      <div class="card" style="margin-bottom: 1.5rem; border-left: 5px solid #2563eb; padding: 1.5rem;">
        <!-- MAIN PROJECT HEADING SECTION -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.35rem;">
              <span style="background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 700; font-size: 0.8rem;">
                📍 City: <%= proj.work_location %>
              </span>
              <span style="background: #f1f5f9; color: #334155; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px;">
                <%= proj.count %> Receipts Recorded
              </span>
            </div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin: 0;">
              🏗️ <%= proj.project_name %>
            </h2>
            <div style="font-size: 0.9rem; color: #475569; margin-top: 0.25rem;">
              Cumulative Project Expenditure: <strong style="color: #2563eb; font-size: 1.1rem; font-weight: 800;">₹<%= proj.total_spent.toLocaleString('en-IN') %></strong>
            </div>
          </div>

          <!-- ACTION BUTTON: Add More Expense To THIS Specific Project -->
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/expenses/project/new?project_name=<%= encodeURIComponent(proj.project_name) %>" class="btn btn-primary" style="font-weight: 700;">
              <i class="fa-solid fa-plus"></i> + Add Expense to <%= proj.project_name %>
            </a>
          </div>
        </div>

        <!-- ITEMIZED RECEIPTS TABLE UNDER THIS PROJECT HEADING -->
        <div class="table-responsive" style="margin-top: 1rem;">
          <table class="table" style="font-size: 0.88rem;">
            <thead>
              <tr>
                <th>Title, Vendor & Staff In-Charge</th>
                <th>Category</th>
                <th>Amount (₹)</th>
                <th>Date</th>
                <th>Payment Mode</th>
                <th>Status</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% (proj.items || []).forEach(item => { %>
                <tr>
                  <td>
                    <strong style="font-size: 0.95rem; color: #0f172a;"><%= item.title %></strong>
                    <% if (item.vendor_name) { %>
                      <br><small style="color: #92400e;">🏢 <%= item.vendor_name %></small>
                    <% } %>
                    <% if (item.responsible_employee_name) { %>
                      <br><small style="color: #0369a1; font-weight: 600;">👤 In-Charge: <%= item.responsible_employee_name %></small>
                    <% } %>
                  </td>
                  <td><span style="background: #f1f5f9; padding: 0.15rem 0.45rem; border-radius: 4px; font-weight: 600;"><%= item.category %></span></td>
                  <td><strong style="font-size: 1.05rem; color: #0f172a;">₹<%= item.amount.toLocaleString('en-IN') %></strong></td>
                  <td><%= item.date %></td>
                  <td>💳 <%= item.payment_mode %></td>
                  <td>
                    <% if (item.payment_status === 'Paid') { %>
                      <span class="badge badge-approved" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">🟢 Paid</span>
                    <% } else { %>
                      <span class="badge badge-danger" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;">🔴 Unpaid</span>
                    <% } %>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <% if (item.payment_status !== 'Paid') { %>
                      <a href="/expenses/company/<%= item.id %>/pay" class="btn btn-sm btn-primary" style="background: #059669; border-color: #059669; padding: 0.25rem 0.55rem; font-size: 0.75rem;">
                        <i class="fa-solid fa-circle-check"></i> Mark Paid
                      </a>
                    <% } %>
                    <form action="/expenses/company/<%= item.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this expense receipt?');">
                      <button type="submit" class="btn btn-sm btn-secondary" style="color: #dc2626; padding: 0.25rem 0.5rem; font-size: 0.75rem;" title="Delete Record">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% }); %>
  <% } %>

<% } else if (activeTab === 'company') { %>
  <!-- TAB 2: DEDICATED COMPANY OPERATIONAL OVERHEAD BILLS TABLE -->
  <div class="card" style="border-top: 4px solid #059669;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2 class="card-title"><i class="fa-solid fa-landmark" style="color: #059669;"></i> Company Operational Overhead Bills (<%= companyExpenses.length %> Records)</h2>
      <a href="/expenses/company/new" class="btn btn-sm btn-primary" style="background: #059669; border-color: #059669;">
        <i class="fa-solid fa-plus"></i> + Add Company Overhead Bill
      </a>
    </div>

    <% if (companyExpenses.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted); font-size: 1rem;">No company operational overhead bills recorded yet.</p>
        <a href="/expenses/company/new" class="btn btn-primary" style="background: #059669; border-color: #059669; margin-top: 1rem;">
          <i class="fa-solid fa-plus"></i> + Add First Company Overhead Bill
        </a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Office Location</th>
              <th>Bill Title, Category & Vendor</th>
              <th>Staff In-Charge</th>
              <th>Amount (₹)</th>
              <th>Date</th>
              <th>Payment Mode</th>
              <th>Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% companyExpenses.forEach(exp => { %>
              <tr>
                <td>
                  <span style="background: #ecfdf5; color: #047857; padding: 0.2rem 0.55rem; border-radius: 4px; font-weight: 700; font-size: 0.8rem;">
                    📍 <%= exp.work_location %>
                  </span>
                </td>
                <td>
                  <strong style="font-size: 0.95rem; color: #0f172a;"><%= exp.title %></strong>
                  <div style="margin-top: 0.25rem; display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
                    <span style="background: #f1f5f9; color: #334155; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                      🏷️ <%= exp.category %>
                    </span>
                    <% if (exp.vendor_name) { %>
                      <span style="background: #fef3c7; color: #92400e; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                        🏢 <%= exp.vendor_name %>
                      </span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (exp.responsible_employee_name) { %>
                    <span style="background: #e0f2fe; color: #0369a1; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.78rem; font-weight: 600;">
                      👤 <%= exp.responsible_employee_name %>
                    </span>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.8rem;">Unassigned</span>
                  <% } %>
                </td>
                <td><strong style="font-size: 1.05rem; color: #059669;">₹<%= exp.amount.toLocaleString('en-IN') %></strong></td>
                <td><div style="font-weight: 600;"><%= exp.date %></div></td>
                <td><div style="font-weight: 600; font-size: 0.85rem; color: #334155;">💳 <%= exp.payment_mode %></div></td>
                <td>
                  <% if (exp.payment_status === 'Paid') { %>
                    <span class="badge badge-approved" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">🟢 Paid</span>
                  <% } else { %>
                    <span class="badge badge-danger" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;">🔴 Unpaid</span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <% if (exp.payment_status !== 'Paid') { %>
                    <a href="/expenses/company/<%= exp.id %>/pay" class="btn btn-sm btn-primary" style="background: #059669; border-color: #059669; padding: 0.25rem 0.55rem; font-size: 0.75rem; margin-right: 0.3rem;">
                      <i class="fa-solid fa-circle-check"></i> Mark Paid
                    </a>
                  <% } %>
                  <form action="/expenses/company/<%= exp.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this overhead bill record?');">
                    <button type="submit" class="btn btn-sm btn-secondary" style="color: #dc2626; padding: 0.25rem 0.5rem; font-size: 0.75rem;" title="Delete Record">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<% } else { %>
  <!-- TAB 3: CONSOLIDATED EMPLOYEE EXPENSE & REIMBURSEMENT SUMMARY TABLE -->
  <div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2 class="card-title">
        <i class="fa-solid fa-address-book" style="color: var(--accent);"></i> 
        <% if (selectedEmployeeInfo) { %>
          Expense Ledger Summary for <%= selectedEmployeeInfo.name %>
        <% } else { %>
          Employee Field & Travel Claims (<%= travelExpenses.length %> Employees)
        <% } %>
      </h2>
      <a href="/expenses/travel/new" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-plus"></i> + Add Field Claim
      </a>
    </div>

    <% if (travelExpenses.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-plane-slash" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted); font-size: 1rem;">No employee field expense claims found for selected filter.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table" style="font-size: 0.9rem;">
          <thead>
            <tr>
              <th>Employee Info</th>
              <th>Claims Filed</th>
              <th>Total Claimed (₹)</th>
              <th>Total Paid / Adv (₹)</th>
              <th>Net Accrued Dues (₹)</th>
              <th>Status Summary</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% travelExpenses.forEach(empRecord => { %>
              <tr>
                <td>
                  <strong><%= empRecord.employee_name %></strong>
                  <br><small style="color: var(--text-muted); font-family: monospace;"><%= empRecord.employee_code %></small>
                  <br><span style="background: #f1f5f9; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;"><%= empRecord.emp_location %></span>
                </td>
                <td>
                  <strong style="font-size: 0.95rem; color: #0f172a;"><%= empRecord.claim_count %> Claims</strong>
                  <br><small style="color: var(--text-muted);">Latest: <%= empRecord.latest_date %></small>
                </td>
                <td>
                  <strong style="font-size: 1rem; color: #0f172a;">₹<%= empRecord.total_amount.toLocaleString('en-IN') %></strong>
                </td>
                <td>
                  <strong style="font-size: 0.95rem; color: #047857;">₹<%= empRecord.advance_paid.toLocaleString('en-IN') %></strong>
                </td>
                <td>
                  <strong style="font-size: 1.05rem; color: <%= empRecord.dues_amount > 0 ? '#b91c1c' : '#059669' %>;">
                    ₹<%= empRecord.dues_amount.toLocaleString('en-IN') %>
                  </strong>
                </td>
                <td>
                  <% if (empRecord.dues_amount > 0) { %>
                    <span class="badge badge-danger" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;">🔴 Payment Pending</span>
                  <% } else { %>
                    <span class="badge badge-approved" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">🟢 Fully Settled</span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/expenses/employee-ledger/<%= empRecord.employee_id %>" class="btn btn-sm btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.78rem;">
                    <i class="fa-solid fa-eye"></i> View Full Ledger
                  </a>
                  <a href="/expenses/travel/new?employee_id=<%= empRecord.employee_id %>" class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.5rem; font-size: 0.78rem;">
                    <i class="fa-solid fa-plus"></i> + Add Claim
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
