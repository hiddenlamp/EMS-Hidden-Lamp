<%- include('../partials/header', { title: 'Add Project Site Expense', path: '/expenses' }) %>

<div style="max-width: 800px; margin: 0 auto;">
  <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h1 class="page-title"><i class="fa-solid fa-diagram-project" style="color: var(--accent);"></i> Add Project Site Expense Receipt</h1>
      <p class="page-description">Record site material, lab equipment, robotics kits, solar components, or field operational costs specific to a project.</p>
    </div>
    <a href="/expenses?tab=projects" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left"></i> ← Back to Projects
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <div class="card" style="padding: 1.75rem; border-top: 4px solid #2563eb;">
    <form action="/expenses/project" method="POST">
      <input type="hidden" name="expense_type" value="Project">

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Project / Site Name</label>
          <input type="text" name="project_name" class="form-control" placeholder="Type project name or select from list..." required list="projectOptions" value="<%= selectedProject || '' %>" style="font-weight: 600; color: #0f172a;">
          <datalist id="projectOptions">
            <% projects.forEach(p => { %>
              <option value="<%= p %>"></option>
            <% }); %>
          </datalist>
          <small style="color: var(--text-muted); margin-top: 0.35rem; display: block;">
            💡 Select an existing project or type a new project name.
          </small>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Project Location / City</label>
          <input type="text" name="work_location" class="form-control" placeholder="Type city or select location..." required list="locationOptions" style="font-weight: 600; color: #0f172a;">
          <datalist id="locationOptions">
            <% locations.forEach(loc => { %>
              <option value="<%= loc %>"></option>
            <% }); %>
          </datalist>
          <small style="color: var(--text-muted); margin-top: 0.35rem; display: block;">
            💡 Select or type city location for this project.
          </small>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Expense Title / Item Description</label>
          <input type="text" name="title" class="form-control" placeholder="e.g. Site Wiring, Solar Panels, Robotics Hardware" required>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Responsible Staff / Employee In-Charge</label>
          <select name="responsible_employee_id" class="form-control">
            <option value="">-- Optional: Select Employee In-Charge --</option>
            <% (employees || []).forEach(emp => { %>
              <option value="<%= emp.id %>">👤 <%= emp.name %> (<%= emp.employee_code %> - <%= emp.work_location %>)</option>
            <% }); %>
          </select>
          <small style="color: var(--text-muted); margin-top: 0.35rem; display: block;">
            👤 Kis employee ko responsibility di gayi thi?
          </small>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Vendor / Supplier Name</label>
          <input type="text" name="vendor_name" class="form-control" placeholder="e.g. JBVNL, Hardware Store, Supplier">
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Project Expense Category</label>
          <input type="text" name="category" class="form-control" placeholder="Type category or select..." required list="categoryOptions" value="Project Site Material" style="font-weight: 600; color: #0f172a;">
          <datalist id="categoryOptions">
            <% (categories || []).forEach(cat => { %>
              <option value="<%= cat %>"></option>
            <% }); %>
          </datalist>
          <small style="color: var(--text-muted); margin-top: 0.35rem; display: block;">
            💡 e.g. Project Site Material, Lab Equipment, Robotics Kit, Site Labor, Transport.
          </small>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Amount (₹)</label>
          <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required min="0" style="font-size: 1.1rem; font-weight: 800; color: #2563eb;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Date</label>
          <input type="date" name="date" class="form-control" value="<%= todayStr %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Payment Mode</label>
          <select name="payment_mode" class="form-control">
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="UPI">UPI</option>
            <option value="Credit Card">Credit Card</option>
            <option value="Cash">Cash</option>
            <option value="Cheque">Cheque</option>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Payment Status</label>
          <select name="payment_status" class="form-control">
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
            <option value="Partial">Partial</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Invoice / Bill Ref No.</label>
          <input type="text" name="invoice_ref" class="form-control" placeholder="e.g. PRJ-2026-109">
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border); padding-top: 1.25rem;">
        <a href="/expenses?tab=projects" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1.5rem; font-weight: 700;">
          <i class="fa-solid fa-floppy-disk"></i> Save Project Expense
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
