<%- include('../partials/header', { title: 'Pay Employee Dues', path: '/expenses' }) %>

<div style="max-width: 600px; margin: 0 auto;">
  <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h1 class="page-title"><i class="fa-solid fa-money-bill-transfer" style="color: var(--accent);"></i> Record Payout / Reimbursement</h1>
      <p class="page-description">Pay full or partial reimbursement dues to <strong><%= claim.employee_name %></strong>.</p>
    </div>
    <a href="/expenses/employee-ledger/<%= claim.employee_id %>" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left"></i> ← Back to Ledger
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <div class="card" style="padding: 1.75rem;">
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.25rem; margin-bottom: 1.5rem;">
      <div style="font-weight: 800; color: #0f172a; font-size: 1.15rem;"><%= claim.employee_name %></div>
      <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">
        Project: <strong><%= claim.project_name || 'General Corporate' %></strong> | Code: <%= claim.employee_code %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1rem; background: #fff; padding: 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem;">
        <div>Total Claim: <strong>₹<%= claim.total_amount.toLocaleString('en-IN') %></strong></div>
        <div>Already Paid: <strong style="color: #047857;">₹<%= claim.advance_paid.toLocaleString('en-IN') %></strong></div>
      </div>

      <div style="margin-top: 0.85rem; font-size: 1.25rem; font-weight: 800; color: #b91c1c;">
        Current Remaining Dues: ₹<%= claim.dues_amount.toLocaleString('en-IN') %>
      </div>
    </div>

    <form action="/expenses/travel/<%= claim.id %>/status" method="POST">
      <input type="hidden" name="status" value="Approved">
      <input type="hidden" name="redirect_ledger" value="true">

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label class="form-label" style="font-weight: 700;">Amount Being Paid Right Now (₹)</label>
        <input type="number" step="0.01" name="payment_amount" class="form-control" value="<%= claim.dues_amount %>" max="<%= claim.dues_amount %>" required min="0.01" style="font-size: 1.2rem; font-weight: 800; color: #059669;">
        <small style="color: var(--text-muted); margin-top: 0.4rem; display: block;">
          💡 You can pay the full dues amount (₹<%= claim.dues_amount.toLocaleString('en-IN') %>) or any partial amount. Remaining dues will be updated automatically.
        </small>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border); padding-top: 1.25rem;">
        <a href="/expenses/employee-ledger/<%= claim.employee_id %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" style="background: #059669; border-color: #059669; padding: 0.65rem 1.5rem; font-weight: 700;">
          <i class="fa-solid fa-check"></i> Confirm Payment
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
