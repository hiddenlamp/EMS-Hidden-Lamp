<%- include('../partials/header', { title: 'Add Field Expense Claim', path: '/expenses' }) %>

<div style="max-width: 850px; margin: 0 auto;">
  <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h1 class="page-title"><i class="fa-solid fa-user-shield" style="color: var(--accent);"></i> Add Employee Field Expense Claim</h1>
      <p class="page-description">Record travel ticket claims, stay, fooding, or out-of-pocket employee expense reimbursements.</p>
    </div>
    <a href="/expenses?tab=travel" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left"></i> ← Back to Expenses
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <div class="card" style="padding: 1.75rem;">
    <form action="/expenses/travel" method="POST">
      <!-- Admin Control Banner -->
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 0.85rem 1.1rem; margin-bottom: 1.25rem; font-size: 0.88rem; color: #166534; display: flex; align-items: center; gap: 0.6rem;">
        <i class="fa-solid fa-shield-halved" style="font-size: 1.2rem; color: #15803d;"></i>
        <div><strong>Admin Control Form Entry</strong>: Enter paper reimbursement slips, WhatsApp bill photos, or field claims on behalf of staff.</div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Select / Enter Project Name</label>
          <input type="text" name="project_name" class="form-control" placeholder="Type new project name or select from list..." required list="projectOptions" value="<%= selectedProject || '' %>" style="font-weight: 600; color: #0f172a;">
          <datalist id="projectOptions">
            <% projects.forEach(p => { %>
              <option value="<%= p %>"></option>
            <% }); %>
          </datalist>
          <small style="color: var(--text-muted); margin-top: 0.35rem; display: block;">
            💡 Select an existing project or type a new project name manually.
          </small>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Select Employee</label>
          <select name="employee_id" id="claim_employee_select" class="form-control" required>
            <option value="">-- Select Employee --</option>
            <% employees.forEach(emp => { %>
              <option value="<%= emp.id %>" <%= String(selectedEmployeeId) === String(emp.id) ? 'selected' : '' %>><%= emp.name %> (<%= emp.employee_code %> - <%= emp.work_location %>)</option>
            <% }); %>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Claim Category</label>
          <select name="claim_type" id="claim_type_select" class="form-control" onchange="toggleClaimTypeFields()" required>
            <option value="Travel">✈️ Travel / Outstation Trip</option>
            <option value="Purchase">🛒 Equipment & Hardware Purchase</option>
            <option value="Supplies">📄 Office Supplies & Printing</option>
            <option value="Client Meeting">☕ Client Meeting & Entertainment</option>
            <option value="Medical">🏥 Medical & Emergency</option>
            <option value="Other">🔧 Other Out-of-Pocket Expense</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Submission Channel / Source</label>
          <select name="submission_source" class="form-control">
            <option value="Offline Form">📄 Offline Paper Reimbursement Form</option>
            <option value="WhatsApp">📱 WhatsApp Message / Chat Receipt</option>
            <option value="Email">📧 Email Attachment / Bill</option>
            <option value="Direct Claim">🗣️ Direct Verbal / Cash Claim</option>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Bill / Receipt / Ref No.</label>
          <input type="text" name="receipt_ref" class="form-control" placeholder="e.g. WA-BILL-9021 or Form #104">
        </div>
        <div class="form-group" id="field_item_title" style="display: none;">
          <label class="form-label" style="font-weight: 700;">Item / Purchase Title</label>
          <input type="text" name="item_title" class="form-control" placeholder="e.g. Wireless Mouse & Keyboard for Office">
        </div>
      </div>

      <!-- Travel Specific Route Fields -->
      <div id="fields_travel_route" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">From Location</label>
          <input type="text" name="from_location" class="form-control" placeholder="e.g. Hazaribagh">
        </div>
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">To Location</label>
          <input type="text" name="to_location" class="form-control" placeholder="e.g. Patna Office">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label" style="font-weight: 700;">Purpose / Reason for Expense</label>
        <input type="text" name="purpose" class="form-control" placeholder="e.g. Site Audit / Purchasing Office Supplies" required>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
        <div class="form-group">
          <label class="form-label" style="font-weight: 700;">Date / Start Date</label>
          <input type="date" name="start_date" class="form-control" value="<%= todayStr %>" required>
        </div>
        <div class="form-group" id="field_end_date">
          <label class="form-label" style="font-weight: 700;">End Date (Travel)</label>
          <input type="date" name="end_date" class="form-control" value="<%= todayStr %>">
        </div>
      </div>

      <!-- Non-Travel Direct Bill Amount Input -->
      <div class="form-group" id="field_direct_amount" style="margin-bottom: 1.25rem; display: none;">
        <label class="form-label" style="font-weight: 700;">Total Bill Amount (₹)</label>
        <input type="number" step="0.01" id="t_direct_total" name="claim_total_amount" class="form-control calc-trigger" placeholder="0.00" min="0">
      </div>

      <!-- Travel Breakdown Inputs -->
      <div id="fields_travel_breakdown" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.25rem;">
        <h4 style="font-size: 0.95rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; color: #334155;">💰 Travel Breakdown & Advance</h4>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
          <div class="form-group">
            <label class="form-label">✈️ Traveling Cost (₹)</label>
            <input type="number" step="0.01" id="t_travel" name="travel_cost" class="form-control calc-trigger" value="0" min="0">
          </div>
          <div class="form-group">
            <label class="form-label">🍔 Fooding Cost (₹)</label>
            <input type="number" step="0.01" id="t_food" name="food_cost" class="form-control calc-trigger" value="0" min="0">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
          <div class="form-group">
            <label class="form-label">🏨 Stay / Hotel Cost (₹)</label>
            <input type="number" step="0.01" id="t_stay" name="stay_cost" class="form-control calc-trigger" value="0" min="0">
          </div>
          <div class="form-group">
            <label class="form-label">📦 Miscellaneous Cost (₹)</label>
            <input type="number" step="0.01" id="t_misc" name="misc_cost" class="form-control calc-trigger" value="0" min="0">
          </div>
        </div>
      </div>

      <!-- Advance & Calculation Summary Container -->
      <div style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" style="font-weight: 700;">💵 Advance / Company Paid Amount (Kitna Diya Gaya)</label>
          <input type="number" step="0.01" id="t_advance" name="advance_paid" class="form-control calc-trigger" value="0" min="0">
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.85rem 1.25rem; font-size: 0.95rem;">
          <div>Total Bill / Claim: <strong id="disp_total" style="color: #0f172a; font-size: 1.1rem;">₹0.00</strong></div>
          <div>New Claim Dues: <strong id="disp_dues" style="color: #b91c1c; font-size: 1.1rem;">₹0.00</strong></div>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label class="form-label" style="font-weight: 700;">Additional Notes / Remarks</label>
        <textarea name="notes" class="form-control" rows="2" placeholder="Optional notes or receipt references..."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border); padding-top: 1.25rem;">
        <a href="/expenses?tab=travel" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1.5rem; font-weight: 700;">
          <i class="fa-solid fa-paper-plane"></i> Submit Claim
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleClaimTypeFields() {
  const type = document.getElementById('claim_type_select').value;
  const isTravel = type === 'Travel';

  document.getElementById('fields_travel_route').style.display = isTravel ? 'grid' : 'none';
  document.getElementById('fields_travel_breakdown').style.display = isTravel ? 'block' : 'none';
  document.getElementById('field_end_date').style.display = isTravel ? 'block' : 'none';

  document.getElementById('field_item_title').style.display = isTravel ? 'none' : 'block';
  document.getElementById('field_direct_amount').style.display = isTravel ? 'none' : 'block';

  calculateClaimTotals();
}

function calculateClaimTotals() {
  const type = document.getElementById('claim_type_select').value;
  let total = 0;

  if (type === 'Travel') {
    const t = parseFloat(document.getElementById('t_travel').value) || 0;
    const f = parseFloat(document.getElementById('t_food').value) || 0;
    const s = parseFloat(document.getElementById('t_stay').value) || 0;
    const m = parseFloat(document.getElementById('t_misc').value) || 0;
    total = t + f + s + m;
  } else {
    total = parseFloat(document.getElementById('t_direct_total').value) || 0;
  }

  const adv = parseFloat(document.getElementById('t_advance').value) || 0;
  const dues = Math.max(0, total - adv);

  document.getElementById('disp_total').innerText = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
  document.getElementById('disp_dues').innerText = '₹' + dues.toLocaleString('en-IN', { minimumFractionDigits: 2 });
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.calc-trigger').forEach(input => {
    input.addEventListener('input', calculateClaimTotals);
  });
});
</script>

<%- include('../partials/footer') %>
