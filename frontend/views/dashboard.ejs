<%- include('partials/header', { title: 'Executive Overview', path: '/dashboard' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Executive Overview & Payroll Hub</h1>
    <p class="page-description">Real-time headcount tracking, location-wise salary budget distribution, and active processing cycles.</p>
  </div>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/employees/new" class="btn btn-secondary"><i class="fa-solid fa-user-plus"></i> Add Employee</a>
    <a href="/payroll" class="btn btn-primary"><i class="fa-solid fa-play"></i> Process Payroll Run</a>
  </div>
</div>

<div class="metrics-grid">
  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-users"></i></div>
    <div>
      <div class="metric-value"><%= activeCount %></div>
      <div class="metric-label">Active Headcount</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-purple">
    <div class="metric-icon"><i class="fa-solid fa-location-dot"></i></div>
    <div>
      <div class="metric-value"><%= locationCount %></div>
      <div class="metric-label">Operating Locations</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-orange">
    <div class="metric-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
    <div>
      <div class="metric-value">₹<%= totalBudget.toLocaleString('en-IN') %></div>
      <div class="metric-label">Monthly Comp Budget</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
    <div>
      <div class="metric-value"><%= runCount %></div>
      <div class="metric-label">Processed Cycles</div>
    </div>
  </div>
</div>

<div class="form-grid" style="grid-template-columns: 3fr 2fr; gap: 1.5rem; align-items: start;">
  <!-- Location-Wise Summary Card -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title"><i class="fa-solid fa-building-user" style="color: var(--accent);"></i> Location-Wise Headcount & Budget</h2>
      <a href="/employees" class="btn btn-sm btn-secondary">View Directory</a>
    </div>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Work Location</th>
            <th style="text-align: center;">Headcount</th>
            <th style="text-align: right;">Monthly Budget</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% locationSummary.forEach((loc, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><strong><%= loc.work_location %></strong></td>
              <td style="text-align: center;">
                <span class="badge" style="background: #e2e8f0; color: #1e293b; font-weight: 700;"><%= loc.heads %> Employees</span>
              </td>
              <td style="text-align: right; font-weight: 700; color: #059669;">₹<%= (loc.location_budget || 0).toLocaleString('en-IN') %></td>
              <td style="text-align: right;">
                <a href="/employees?location=<%= encodeURIComponent(loc.work_location) %>" class="btn btn-sm btn-secondary">View Register</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr style="background: #f8fafc; font-weight: 800;">
            <td colspan="2">TOTAL WORKFORCE</td>
            <td style="text-align: center; color: #2563eb;"><%= activeCount %> Active</td>
            <td style="text-align: right; color: #059669; font-size: 1.05rem;">₹<%= totalBudget.toLocaleString('en-IN') %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Recent Payroll Runs Card -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title"><i class="fa-solid fa-clock-rotate-left" style="color: var(--accent);"></i> Recent Payroll Cycles</h2>
      <a href="/payroll" class="btn btn-sm btn-secondary">View All</a>
    </div>

    <% if (recentRuns.length === 0) { %>
      <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
        <i class="fa-solid fa-calendar-plus" style="font-size: 2.2rem; margin-bottom: 0.75rem; opacity: 0.5;"></i>
        <p style="font-size: 0.9rem; font-weight: 600;">No payroll cycles created yet.</p>
        <a href="/payroll" class="btn btn-sm btn-primary" style="margin-top: 0.75rem;">Process Payroll Run</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Period</th>
              <th>Pay Date</th>
              <th>Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentRuns.forEach(run => { %>
              <tr>
                <td><strong><%= run.period %></strong></td>
                <td><%= run.pay_date %></td>
                <td>
                  <span class="badge badge-<%= run.status %>"><%= run.status %></span>
                </td>
                <td style="text-align: right;">
                  <a href="/payroll/<%= run.id %>" class="btn btn-sm btn-secondary">Inspect</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
