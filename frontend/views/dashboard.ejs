<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Payroll Dashboard (July 2026 Register)</h1>
    <p class="page-description">Welcome back! Manage location-wise employee heads, salary budgets, and monthly payroll processing.</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/employees/new" class="btn btn-secondary">+ Add Employee</a>
    <a href="/payroll" class="btn btn-primary">Process Payroll Run</a>
  </div>
</div>

<div class="metrics-grid">
  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-users"></i></div>
    <div>
      <div class="metric-value"><%= activeCount %></div>
      <div class="metric-label">Total Employee Heads</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-purple">
    <div class="metric-icon"><i class="fa-solid fa-map-location-dot"></i></div>
    <div>
      <div class="metric-value"><%= locationCount %></div>
      <div class="metric-label">Locations Covered</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-orange">
    <div class="metric-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
    <div>
      <div class="metric-value">₹<%= totalBudget.toLocaleString('en-IN') %></div>
      <div class="metric-label">Monthly Salary Budget</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
    <div>
      <div class="metric-value"><%= runCount %></div>
      <div class="metric-label">Total Payroll Runs</div>
    </div>
  </div>
</div>

<div class="form-grid" style="grid-template-columns: 3fr 2fr; gap: 1.5rem; align-items: start;">
  <!-- Location-Wise Summary Card -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Place-Wise Summary (Hidden Lamp)</h2>
      <a href="/employees" class="btn btn-sm btn-secondary">View Register</a>
    </div>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Sl.</th>
            <th>Location</th>
            <th style="text-align: center;">Heads</th>
            <th style="text-align: right;">Monthly Budget</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% locationSummary.forEach((loc, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><strong><%= loc.work_location %></strong></td>
              <td style="text-align: center;">
                <span class="badge" style="background: #e2e8f0; color: #1e293b;"><%= loc.heads %></span>
              </td>
              <td style="text-align: right; font-weight: 600; color: #059669;">₹<%= (loc.location_budget || 0).toLocaleString('en-IN') %></td>
              <td style="text-align: right;">
                <a href="/employees?location=<%= encodeURIComponent(loc.work_location) %>" class="btn btn-sm btn-secondary">Details</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr style="background: #f8fafc; font-weight: 700;">
            <td colspan="2">GRAND TOTAL</td>
            <td style="text-align: center; color: #2563eb;"><%= activeCount %></td>
            <td style="text-align: right; color: #059669;">₹<%= totalBudget.toLocaleString('en-IN') %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Recent Payroll Runs Card -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Recent Payroll Runs</h2>
      <a href="/payroll" class="btn btn-sm btn-secondary">View All</a>
    </div>

    <% if (recentRuns.length === 0) { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No payroll runs created yet. Click <strong>Process Payroll Run</strong> to process the July 2026 cycle.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Period</th>
              <th>Pay Date</th>
              <th>Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentRuns.forEach(run => { %>
              <tr>
                <td><strong><%= run.period %></strong></td>
                <td><%= run.pay_date %></td>
                <td>
                  <span class="badge badge-<%= run.status %>"><%= run.status %></span>
                </td>
                <td style="text-align: right;">
                  <a href="/payroll/<%= run.id %>" class="btn btn-sm btn-secondary">View</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
