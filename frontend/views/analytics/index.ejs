<%- include('../partials/header', { title: 'Report and Analytics', path: '/analytics' }) %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="page-title">Corporate Reports & Business Intelligence</h1>
    <p class="page-description">Comprehensive financial analytics across payroll, employee reimbursement claims, and company overhead.</p>
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/analytics/export/payroll-csv" class="btn btn-secondary" style="font-size: 0.85rem;">
      <i class="fa-solid fa-file-csv"></i> Download Payroll CSV
    </a>
    <a href="/analytics/export/expenses-csv" class="btn btn-secondary" style="font-size: 0.85rem;">
      <i class="fa-solid fa-file-csv"></i> Download Claims CSV
    </a>
    <a href="/analytics/export/company-csv" class="btn btn-secondary" style="font-size: 0.85rem;">
      <i class="fa-solid fa-file-csv"></i> Download Overhead CSV
    </a>
    <button type="button" class="btn btn-primary" onclick="window.print()" style="font-size: 0.85rem;">
      <i class="fa-solid fa-print"></i> Print Executive Summary
    </button>
  </div>
</div>

<!-- MONTH, YEAR & LOCATION FILTER BAR -->
<div class="card" style="margin-bottom: 1.5rem; background: #ffffff; padding: 1.25rem;">
  <form action="/analytics" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; margin: 0;">
    <input type="hidden" name="tab" value="<%= activeTab %>">
    
    <div style="flex: 1; min-width: 140px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-calendar-days" style="color: var(--accent);"></i> Select Month
      </label>
      <select name="month" class="form-control" style="font-size: 0.9rem;">
        <option value="">⚡ All Months</option>
        <% monthNames.forEach(m => { %>
          <option value="<%= m.num %>" <%= selectedMonth === m.num ? 'selected' : '' %>><%= m.name %></option>
        <% }); %>
      </select>
    </div>

    <div style="flex: 1; min-width: 120px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-calendar" style="color: var(--accent);"></i> Select Year
      </label>
      <select name="year" class="form-control" style="font-size: 0.9rem;">
        <option value="">⚡ All Years</option>
        <% years.forEach(y => { %>
          <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
        <% }); %>
      </select>
    </div>

    <div style="flex: 1.2; min-width: 160px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-location-dot" style="color: var(--accent);"></i> Work Location
      </label>
      <select name="location" class="form-control" style="font-size: 0.9rem;">
        <option value="all" <%= selectedLocation === 'all' ? 'selected' : '' %>>⚡ All Locations</option>
        <% locations.forEach(loc => { %>
          <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
        <% }); %>
      </select>
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <button type="submit" class="btn btn-primary" style="font-size: 0.88rem; font-weight: 600;">
        <i class="fa-solid fa-filter"></i> Filter Report
      </button>
      <% if (selectedMonth || selectedYear || (selectedLocation && selectedLocation !== 'all')) { %>
        <a href="/analytics?tab=<%= activeTab %>" class="btn btn-secondary" style="font-size: 0.88rem; font-weight: 600;">
          ✖ Clear
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- TOP METRIC KPI DASHBOARD CARDS -->
<div class="metrics-grid">
  <div class="metric-card bg-pastel-blue">
    <div class="metric-icon"><i class="fa-solid fa-money-check-dollar"></i></div>
    <div>
      <div class="metric-value">₹<%= kpiPayroll.total_net.toLocaleString('en-IN') %></div>
      <div class="metric-label">Total Distributed Net Salary</div>
      <small style="color: #64748b;">Gross: ₹<%= kpiPayroll.total_gross.toLocaleString('en-IN') %></small>
    </div>
  </div>

  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-receipt"></i></div>
    <div>
      <div class="metric-value">₹<%= kpiExpenses.total_claimed.toLocaleString('en-IN') %></div>
      <div class="metric-label">Employee Expense Claims</div>
      <small style="color: #047857; font-weight: 600;">Paid: ₹<%= kpiExpenses.total_paid.toLocaleString('en-IN') %></small>
    </div>
  </div>

  <div class="metric-card bg-pastel-red" style="background: #fff1f2; border-color: #fecdd3;">
    <div class="metric-icon" style="background: #ffe4e6; color: #e11d48;"><i class="fa-solid fa-scale-unbalanced"></i></div>
    <div>
      <div class="metric-value" style="color: #be123c;">₹<%= kpiExpenses.total_dues.toLocaleString('en-IN') %></div>
      <div class="metric-label" style="color: #9f1239;">Total Accrued Balance Dues</div>
      <small style="color: #be123c;">Pending Payouts</small>
    </div>
  </div>

  <div class="metric-card bg-pastel-orange">
    <div class="metric-icon"><i class="fa-solid fa-building"></i></div>
    <div>
      <div class="metric-value">₹<%= kpiCompany.total_overhead.toLocaleString('en-IN') %></div>
      <div class="metric-label">Company Operational Overhead</div>
      <small style="color: #9a3412;">Utilities, Rent & Tech</small>
    </div>
  </div>
</div>

<!-- TAB NAVIGATION SWITCHER -->
<div class="card" style="margin-bottom: 1.5rem; padding: 0.75rem 1.25rem;">
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/analytics?tab=payroll&year=<%= selectedYear %>&month=<%= selectedMonth %>&location=<%= encodeURIComponent(selectedLocation) %>" class="btn <%= activeTab === 'payroll' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600; font-size: 0.88rem;">
      <i class="fa-solid fa-chart-column"></i> Payroll & Salary Analytics
    </a>
    <a href="/analytics?tab=expenses&year=<%= selectedYear %>&month=<%= selectedMonth %>&location=<%= encodeURIComponent(selectedLocation) %>" class="btn <%= activeTab === 'expenses' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600; font-size: 0.88rem;">
      <i class="fa-solid fa-plane-circle-check"></i> Employee Expense Claims
    </a>
    <a href="/analytics?tab=company&year=<%= selectedYear %>&month=<%= selectedMonth %>&location=<%= encodeURIComponent(selectedLocation) %>" class="btn <%= activeTab === 'company' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600; font-size: 0.88rem;">
      <i class="fa-solid fa-landmark"></i> Company Overhead
    </a>
    <a href="/analytics?tab=ai&year=<%= selectedYear %>&month=<%= selectedMonth %>&location=<%= encodeURIComponent(selectedLocation) %>" class="btn <%= activeTab === 'ai' ? 'btn-primary' : 'btn-secondary' %>" style="font-weight: 600; font-size: 0.88rem; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border: none;">
      <i class="fa-solid fa-sparkles"></i> Ask AI Data Assistant
    </a>
  </div>
</div>

<% if (activeTab === 'payroll') { %>
  <!-- TAB 1: PAYROLL ANALYTICS -->
  <div class="form-grid" style="grid-template-columns: 2fr 1fr; gap: 1.5rem; align-items: start; margin-bottom: 1.5rem;">
    <!-- Main Monthly Salary Chart -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title"><i class="fa-solid fa-chart-line" style="color: var(--accent);"></i> Monthly Payroll Disbursal Trend</h2>
      </div>
      <div style="height: 380px;">
        <canvas id="expensesChart"></canvas>
      </div>
    </div>

    <!-- Department Wise Spend Table -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title"><i class="fa-solid fa-sitemap" style="color: var(--accent);"></i> Department Wise Payroll Spend</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Department</th>
              <th>Headcount</th>
              <th style="text-align: right;">Total Spend (₹)</th>
            </tr>
          </thead>
          <tbody>
            <% if (deptSpend.length === 0) { %>
              <tr><td colspan="3" style="text-align: center; color: var(--text-muted);">No department payroll data found</td></tr>
            <% } else { %>
              <% deptSpend.forEach(d => { %>
                <tr>
                  <td><strong><%= d.department %></strong></td>
                  <td><%= d.staff_count %> Staff</td>
                  <td style="text-align: right; font-weight: 700; color: #2563eb;">₹<%= d.total_net.toLocaleString('en-IN') %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Location Wise Payroll Spend Breakdown Table -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title"><i class="fa-solid fa-location-dot" style="color: var(--accent);"></i> Location Wise Payroll & Salary Disbursal Breakdown</h2>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Work Location</th>
            <th>Staff Count</th>
            <th style="text-align: right;">Gross Pay (₹)</th>
            <th style="text-align: right;">Deductions (₹)</th>
            <th style="text-align: right;">Net Salary Paid (₹)</th>
          </tr>
        </thead>
        <tbody>
          <% if (locationSpend.length === 0) { %>
            <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No location spend data found</td></tr>
          <% } else { %>
            <% locationSpend.forEach(l => { %>
              <tr>
                <td><strong><%= l.work_location %></strong></td>
                <td><%= l.staff_count %> Staff</td>
                <td style="text-align: right; color: #059669;">₹<%= l.total_gross.toLocaleString('en-IN') %></td>
                <td style="text-align: right; color: #dc2626;">₹<%= l.total_deductions.toLocaleString('en-IN') %></td>
                <td style="text-align: right; font-weight: 700; color: #2563eb;">₹<%= l.total_net.toLocaleString('en-IN') %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<% } else if (activeTab === 'expenses') { %>
  <!-- TAB 2: EMPLOYEE EXPENSES ANALYTICS -->
  <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
    <!-- Claims by Category -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title"><i class="fa-solid fa-list-check" style="color: var(--accent);"></i> Employee Claims Category Breakdown</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Claim Type</th>
              <th>Total Claims</th>
              <th style="text-align: right;">Claimed Amount (₹)</th>
              <th style="text-align: right;">Accrued Dues (₹)</th>
            </tr>
          </thead>
          <tbody>
            <% if (expenseCategoryBreakdown.length === 0) { %>
              <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No expense claim records found</td></tr>
            <% } else { %>
              <% expenseCategoryBreakdown.forEach(c => { %>
                <tr>
                  <td><strong><%= c.category %></strong></td>
                  <td><%= c.claim_count %> Claims</td>
                  <td style="text-align: right; font-weight: 600;">₹<%= c.total_amount.toLocaleString('en-IN') %></td>
                  <td style="text-align: right; font-weight: 700; color: #be123c;">₹<%= c.dues_amount.toLocaleString('en-IN') %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top Claimants Table -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title"><i class="fa-solid fa-crown" style="color: var(--accent);"></i> Top Employee Expense Claimants</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Employee</th>
              <th>Location</th>
              <th style="text-align: right;">Total Claimed (₹)</th>
              <th style="text-align: right;">Outstanding Dues (₹)</th>
            </tr>
          </thead>
          <tbody>
            <% if (topExpenseEmployees.length === 0) { %>
              <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No expense claimants found</td></tr>
            <% } else { %>
              <% topExpenseEmployees.forEach(emp => { %>
                <tr>
                  <td><strong><%= emp.name %></strong></td>
                  <td><small style="color: var(--text-muted);"><%= emp.work_location %></small></td>
                  <td style="text-align: right; font-weight: 700;">₹<%= emp.total_claimed.toLocaleString('en-IN') %></td>
                  <td style="text-align: right; font-weight: 700; color: #dc2626;">₹<%= emp.total_dues.toLocaleString('en-IN') %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

<% } else if (activeTab === 'company') { %>
  <!-- TAB 3: COMPANY OVERHEAD ANALYTICS -->
  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2 class="card-title"><i class="fa-solid fa-building-circle-check" style="color: var(--accent);"></i> Company Operational Overhead Spend Categories</h2>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Expense Category</th>
            <th>Bills Recorded</th>
            <th>Total Spend (₹)</th>
            <th>Distribution (%)</th>
          </tr>
        </thead>
        <tbody>
          <% if (companyCategorySpend.length === 0) { %>
            <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No company overhead records found</td></tr>
          <% } else { %>
            <% 
              const totalComp = companyCategorySpend.reduce((acc, c) => acc + c.total_amount, 0);
              companyCategorySpend.forEach(c => { 
                const pct = totalComp > 0 ? ((c.total_amount / totalComp) * 100).toFixed(1) : 0;
            %>
              <tr>
                <td>
                  <span style="background: #f1f5f9; color: #334155; padding: 0.2rem 0.55rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;">
                    <%= c.category %>
                  </span>
                </td>
                <td><%= c.bill_count %> Bills</td>
                <td><strong style="font-size: 1rem; color: #0f172a;">₹<%= c.total_amount.toLocaleString('en-IN') %></strong></td>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="flex: 1; background: #e2e8f0; height: 8px; border-radius: 4px; overflow: hidden;">
                      <div style="width: <%= pct %>%; background: #2563eb; height: 100%;"></div>
                    </div>
                    <strong style="font-size: 0.85rem; color: #334155; min-width: 45px;"><%= pct %>%</strong>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<% } else if (activeTab === 'ai') { %>
  <!-- TAB 4: ASK YOUR DATA (AI & SQL DATA ASSISTANT) -->
  <div class="card" style="margin-bottom: 1.5rem; background: linear-gradient(to right, #eff6ff, #f8fafc); border: 1px solid #bfdbfe;">
    <div class="card-header" style="border-bottom: 1px solid #e2e8f0; margin-bottom: 1rem; padding-bottom: 0.5rem;">
      <h2 class="card-title" style="color: #1e40af;"><i class="fa-solid fa-sparkles"></i> Ask Your Data Assistant (Smart Query Engine)</h2>
      <p style="font-size: 0.85rem; color: #475569; margin: 0.2rem 0 0 0;">Ask questions about salary, travel expenses, company bills, or staff counts in plain English.</p>
    </div>

    <!-- Quick Question Suggestions Chips -->
    <div style="margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <button type="button" class="btn btn-sm btn-secondary" onclick="askQuestion('What is the total gross pay for IT department?')" style="font-size: 0.78rem; background: #fff; border-color: #cbd5e1;">
        💡 Total gross pay for IT department
      </button>
      <button type="button" class="btn btn-sm btn-secondary" onclick="askQuestion('Show top 5 highest paid employees')" style="font-size: 0.78rem; background: #fff; border-color: #cbd5e1;">
        💡 Top 5 highest paid employees
      </button>
      <button type="button" class="btn btn-sm btn-secondary" onclick="askQuestion('What is the total travel expense claimed in Hazaribagh?')" style="font-size: 0.78rem; background: #fff; border-color: #cbd5e1;">
        💡 Travel expense in Hazaribagh
      </button>
    </div>

    <form id="aiForm" onsubmit="submitAiQuery(event)">
      <div style="display: flex; gap: 0.75rem;">
        <input type="text" id="aiQueryInput" class="form-control" placeholder="Ask anything, e.g. 'Show total net pay in Hazaribagh location'" required style="font-size: 0.95rem; background: #fff;">
        <button type="submit" id="aiSubmitBtn" class="btn btn-primary" style="font-weight: 600; padding: 0.6rem 1.25rem;">
          <i class="fa-solid fa-paper-plane"></i> Ask Assistant
        </button>
      </div>
    </form>

    <div id="aiResponseContainer" style="display: none; margin-top: 1.5rem; background: #fff; border-radius: 8px; border: 1px solid #cbd5e1; padding: 1.25rem;">
      <h3 style="font-size: 0.95rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-robot" style="color: #2563eb;"></i> Assistant Answer:
      </h3>
      <div id="aiAnswerText" style="font-size: 0.95rem; color: #334155; line-height: 1.5; white-space: pre-line;"></div>
      <div id="aiSqlText" style="margin-top: 0.75rem; font-size: 0.78rem; color: #64748b; font-family: monospace; background: #f8fafc; padding: 0.5rem; border-radius: 4px;"></div>
    </div>
  </div>
<% } %>

<!-- Chart.js Engine -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  <% if (activeTab === 'payroll' && payrollTrend && payrollTrend.length > 0) { %>
    const periods = <%- JSON.stringify(payrollTrend.map(t => t.period)) %>;
    const grossData = <%- JSON.stringify(payrollTrend.map(t => t.gross_pay)) %>;
    const deductionsData = <%- JSON.stringify(payrollTrend.map(t => t.deductions)) %>;
    const netData = <%- JSON.stringify(payrollTrend.map(t => t.net_pay)) %>;

    const ctx = document.getElementById('expensesChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: periods,
        datasets: [
          {
            label: 'Net Salary Paid (₹)',
            data: netData,
            backgroundColor: '#2563eb',
            borderRadius: 6
          },
          {
            label: 'Total Deductions (₹)',
            data: deductionsData,
            backgroundColor: '#ef4444',
            borderRadius: 6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top' }
        },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true }
        }
      }
    });
  <% } %>

  function askQuestion(text) {
    document.getElementById('aiQueryInput').value = text;
    document.getElementById('aiForm').dispatchEvent(new Event('submit'));
  }

  async function submitAiQuery(e) {
    e.preventDefault();
    const query = document.getElementById('aiQueryInput').value;
    const btn = document.getElementById('aiSubmitBtn');
    const container = document.getElementById('aiResponseContainer');
    const answerEl = document.getElementById('aiAnswerText');
    const sqlEl = document.getElementById('aiSqlText');

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Querying...';

    try {
      const res = await fetch('/analytics/ai-query', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: query })
      });
      const data = await res.json();
      container.style.display = 'block';

      if (data.error) {
        answerEl.innerText = '❌ Error: ' + data.error;
        sqlEl.innerText = '';
      } else {
        answerEl.innerText = data.answer || 'Query processed successfully.';
        sqlEl.innerText = data.sql ? ('Generated SQL: ' + data.sql) : '';
      }
    } catch (err) {
      container.style.display = 'block';
      answerEl.innerText = '❌ Failed to process query: ' + err.message;
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Ask Assistant';
    }
  }
</script>

<%- include('../partials/footer') %>
