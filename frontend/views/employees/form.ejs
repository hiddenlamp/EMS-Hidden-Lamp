<%- include('../partials/header', { title: isEdit ? 'Edit Employee' : 'New Employee' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= isEdit ? 'Edit Employee Profile' : 'Add New Employee' %></h1>
    <p class="page-description">Enter employee profile details, work location, and banking details.</p>
  </div>
  <a href="/employees" class="btn btn-secondary">← Back to Employees</a>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="<%= isEdit ? '/employees/' + employee.id : '/employees' %>" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label for="employee_code" class="form-label">Employee ID / Code</label>
        <input type="text" id="employee_code" name="employee_code" class="form-control" value="<%= employee.employee_code || '' %>" placeholder="e.g. EMP-001">
      </div>

      <div class="form-group">
        <label for="name" class="form-label">Full Name *</label>
        <input type="text" id="name" name="name" class="form-control" value="<%= employee.name || '' %>" required placeholder="e.g. John Doe">
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" value="<%= employee.email || '' %>" placeholder="e.g. john@hiddenlamp.com">
      </div>

      <div class="form-group">
        <label for="designation" class="form-label">Designation *</label>
        <input type="text" id="designation" name="designation" class="form-control" value="<%= employee.designation || '' %>" required placeholder="e.g. Senior Software Engineer">
      </div>

      <div class="form-group">
        <label for="department" class="form-label">Department *</label>
        <input type="text" id="department" name="department" class="form-control" value="<%= employee.department || '' %>" required placeholder="e.g. Engineering">
      </div>

      <div class="form-group">
        <label for="work_location" class="form-label">Working Place / Location *</label>
        <select id="work_location" name="work_location" class="form-control" required onchange="toggleNewLocation()">
          <% if (locations && locations.length > 0) { %>
            <% locations.forEach(loc => { %>
              <option value="<%= loc %>" <%= employee.work_location === loc ? 'selected' : '' %>><%= loc %></option>
            <% }) %>
          <% } %>
          <option value="NEW">Add New Location...</option>
        </select>
        <input type="text" id="work_location_new" name="work_location_new" class="form-control" style="display: none; margin-top: 0.5rem;" placeholder="Enter new location">
      </div>

      <div class="form-group">
        <label for="date_of_joining" class="form-label">Date of Joining *</label>
        <input type="date" id="date_of_joining" name="date_of_joining" class="form-control" value="<%= employee.date_of_joining || '' %>" required>
      </div>

      <div class="form-group">
        <label for="pan" class="form-label">PAN Number</label>
        <input type="text" id="pan" name="pan" class="form-control" value="<%= employee.pan || '' %>" placeholder="e.g. ABCDE1234F">
      </div>

      <div class="form-group">
        <label for="payment_mode" class="form-label">Payment Mode</label>
        <select id="payment_mode" name="payment_mode" class="form-control">
          <option value="Bank Transfer" <%= employee.payment_mode === 'Bank Transfer' || !employee.payment_mode ? 'selected' : '' %>>Bank Transfer</option>
          <option value="Cash" <%= employee.payment_mode === 'Cash' ? 'selected' : '' %>>Cash</option>
        </select>
      </div>

      <div class="form-group">
        <label for="bank_name" class="form-label">Bank Name</label>
        <input type="text" id="bank_name" name="bank_name" class="form-control" value="<%= employee.bank_name || '' %>" placeholder="e.g. HDFC Bank">
      </div>

      <div class="form-group">
        <label for="bank_account" class="form-label">Bank Account Number</label>
        <input type="text" id="bank_account" name="bank_account" class="form-control" value="<%= employee.bank_account || '' %>" placeholder="e.g. 50100123456789">
      </div>

      <div class="form-group">
        <label for="status" class="form-label">Employee Status</label>
        <select id="status" name="status" class="form-control">
          <option value="active" <%= employee.status === 'active' || !employee.status ? 'selected' : '' %>>Active</option>
          <option value="exited" <%= employee.status === 'exited' ? 'selected' : '' %>>Exited</option>
        </select>
      </div>
    </div>

    <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <div>
        <% if (isEdit && employee.id) { %>
          <form action="/employees/<%= employee.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete employee <%= (employee.name || '').replace(/\'/g, "\\'") %>? All associated salary data will be removed.');" style="display: inline; margin: 0;">
            <button type="submit" class="btn btn-secondary" style="color: #dc2626; border-color: #fca5a5; background: #fff5f5;">
              <i class="fa-solid fa-trash"></i> Delete Employee
            </button>
          </form>
        <% } %>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/employees" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Profile' : 'Save & Set Salary Structure' %></button>
      </div>
    </div>
  </form>
</div>

<script>
  function toggleNewLocation() {
    const select = document.getElementById('work_location');
    const input = document.getElementById('work_location_new');
    if (select.value === 'NEW') {
      input.style.display = 'block';
      input.setAttribute('required', 'required');
    } else {
      input.style.display = 'none';
      input.removeAttribute('required');
    }
  }

  // Run on load in case "NEW" is selected initially (unlikely but good practice)
  document.addEventListener('DOMContentLoaded', () => {
    toggleNewLocation();
    
    // If we're editing and the employee's location isn't in the list, we should probably handle it,
    // but the backend query 'SELECT DISTINCT' ensures their current location is in the list.
  });
</script>

<%- include('../partials/footer') %>
