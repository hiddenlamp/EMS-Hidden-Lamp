<%- include('../partials/header', { title: 'Global Repository', path: '/payslips' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Global Payslip Directory & Audit Trail</h1>
    <p class="page-description">Filter payslips by Month/Year, search employee records, inspect breakdown, generate PDF, or send email notifications.</p>
  </div>
</div>

<% if (locals.success) { %>
  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
<% } %>

<!-- MONTH & YEAR FILTER BAR -->
<div class="card" style="background: #ffffff; padding: 1.25rem;">
  <form action="/payslips" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; margin: 0;">
    <div style="flex: 1; min-width: 140px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-calendar-days" style="color: var(--accent);"></i> Select Month
      </label>
      <select name="month" class="form-control" style="font-size: 0.88rem;">
        <option value="">⚡ All Months</option>
        <% monthNames.forEach(m => { %>
          <option value="<%= m.num %>" <%= selectedMonth === m.num ? 'selected' : '' %>><%= m.name %></option>
        <% }); %>
      </select>
    </div>

    <div style="flex: 1; min-width: 120px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-calendar" style="color: var(--accent);"></i> Select Year
      </label>
      <select name="year" class="form-control" style="font-size: 0.88rem;">
        <option value="">⚡ All Years</option>
        <% years.forEach(y => { %>
          <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
        <% }); %>
      </select>
    </div>

    <div style="flex: 1.5; min-width: 200px;">
      <label style="font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 0.35rem; display: block;">
        <i class="fa-solid fa-magnifying-glass" style="color: var(--accent);"></i> Search Employee
      </label>
      <input type="text" name="search" class="form-control" placeholder="Search employee name or code..." value="<%= searchQuery %>" style="font-size: 0.88rem;">
    </div>

    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <button type="submit" class="btn btn-primary" style="font-size: 0.85rem; font-weight: 600;">
        <i class="fa-solid fa-filter"></i> Apply Filter
      </button>
      <% if (selectedMonth || selectedYear || searchQuery) { %>
        <a href="/payslips" class="btn btn-secondary" style="font-size: 0.85rem; font-weight: 600;">
          ✖ Clear
        </a>
      <% } %>
    </div>
  </form>
</div>

<div class="metrics-grid">
  <div class="metric-card bg-pastel-purple">
    <div class="metric-icon"><i class="fa-solid fa-file-invoice"></i></div>
    <div>
      <div class="metric-value"><%= totalGenerated %></div>
      <div class="metric-label">Filtered Generated Payslips</div>
    </div>
  </div>

  <div class="metric-card bg-pastel-green">
    <div class="metric-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
    <div>
      <div class="metric-value">₹<%= totalAmount.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
      <div class="metric-label">Filtered Disbursed Net Salary</div>
    </div>
  </div>
</div>

<div class="card" style="padding: 1.25rem;">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <h2 class="card-title">
      <i class="fa-solid fa-folder-tree" style="color: var(--accent);"></i> Employee Payslip Directory
      <% if (selectedMonth || selectedYear) { %>
        <span style="font-size: 0.8rem; font-weight: 600; color: var(--accent); background: #eff6ff; padding: 0.2rem 0.6rem; border-radius: 6px; margin-left: 0.4rem;">
          <%= selectedMonth ? monthNames.find(m=>m.num===selectedMonth)?.name : '' %> <%= selectedYear %>
        </span>
      <% } %>
    </h2>
  </div>

  <% if (payslips.length === 0) { %>
    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
      <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.5;"></i>
      <p style="font-size: 0.95rem; font-weight: 600; color: #475569;">No payslips match your selected criteria.</p>
      <% if (selectedMonth || selectedYear || searchQuery) { %>
        <a href="/payslips" class="btn btn-secondary" style="margin-top: 0.75rem; font-size: 0.85rem;">View All Payslips</a>
      <% } %>
    </div>
  <% } else { %>
    <!-- DESKTOP DATA TABLE VIEW (Visible on >= 768px) -->
    <div class="desktop-table-container">
      <div class="table-responsive">
        <table class="table" style="width: 100%;">
          <thead>
            <tr>
              <th style="white-space: nowrap;">Payslip Ref No</th>
              <th style="white-space: nowrap;">Period</th>
              <th style="white-space: nowrap;">Employee Name & Email</th>
              <th style="text-align: right; white-space: nowrap;">Monthly Gross</th>
              <th style="text-align: right; white-space: nowrap;">Deductions</th>
              <th style="text-align: right; white-space: nowrap;">Net Salary</th>
              <th style="text-align: center; white-space: nowrap;">Run Status</th>
              <th style="text-align: center; white-space: nowrap;">Email Delivery Status</th>
              <th style="text-align: right; white-space: nowrap;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% payslips.forEach(ps => { %>
              <% 
                const registeredEmail = ps.user_email || (ps.employee_name.toLowerCase().replace(/[^a-z0-9]/g, '') + '@hiddenlamp.com'); 
                const periodParts = (ps.period || '2026-07').split('-');
                const mNum = periodParts.length >= 2 ? String(periodParts[1]).padStart(2, '0') : '07';
                const yNameShort = periodParts[0] || '2026';
                const payslipRefNo = `HL/PS/${mNum}&#8209;${yNameShort}/${String(ps.employee_id || 1).padStart(3, '0')}`;
                const periodFormatted = `${periodParts[0]}&#8209;${mNum}`;
              %>
              <tr>
                <td style="white-space: nowrap; vertical-align: middle;">
                  <span style="font-family: monospace; font-weight: 700; background: #eff6ff; color: #1e40af; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid #bfdbfe; display: inline-block; white-space: nowrap;">
                    <%- payslipRefNo %>
                  </span>
                </td>
                <td style="white-space: nowrap; vertical-align: middle;">
                  <strong style="font-size: 0.88rem; color: #334155; white-space: nowrap;"><%- periodFormatted %></strong>
                </td>
                <td style="white-space: nowrap; vertical-align: middle;">
                  <strong style="font-size: 0.92rem; color: #0f172a; white-space: nowrap;"><%= ps.employee_name %></strong>
                  <br><small style="color: var(--accent); font-weight: 500; font-size: 0.78rem; white-space: nowrap;"><i class="fa-regular fa-envelope"></i> <%= registeredEmail %></small>
                </td>
                <td style="text-align: right; color: #059669; font-weight: 600; white-space: nowrap; vertical-align: middle;">
                  ₹<%= ps.gross_pay.toLocaleString('en-IN') %>
                </td>
                <td style="text-align: right; color: #dc2626; font-weight: 600; white-space: nowrap; vertical-align: middle;">
                  ₹<%= ps.total_deductions.toLocaleString('en-IN') %>
                </td>
                <td style="text-align: right; font-weight: 800; color: #2563eb; font-size: 0.95rem; white-space: nowrap; vertical-align: middle;">
                  ₹<%= ps.net_pay.toLocaleString('en-IN') %>
                </td>
                <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                  <% if (ps.run_status === 'approved') { %>
                    <span class="badge badge-approved" style="font-size: 0.72rem; white-space: nowrap;">Issued</span>
                  <% } else { %>
                    <span class="badge badge-draft" style="font-size: 0.72rem; white-space: nowrap;">Pending</span>
                  <% } %>
                </td>
                <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                  <% if (ps.email_status === 'Dispatched' || ps.email_status === 'Sent') { %>
                    <span class="badge" style="background: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 9999px; font-weight: 700;">
                      <i class="fa-solid fa-circle-check"></i> Dispatched
                    </span>
                    <% if (ps.email_sent_at) { %>
                      <br><small style="font-size: 0.68rem; color: #64748b; font-weight: 500;"><%= ps.email_sent_at.substring(0, 16) %></small>
                    <% } %>
                  <% } else if (ps.email_status === 'Sending...' || ps.email_status === 'Processing') { %>
                    <span class="badge" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #93c5fd; font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 9999px; font-weight: 700;">
                      <i class="fa-solid fa-spinner fa-spin"></i> Sending...
                    </span>
                  <% } else if (ps.email_status === 'Failed') { %>
                    <span class="badge" style="background: #fff1f2; color: #e11d48; border: 1px solid #fca5a5; font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 9999px; font-weight: 700;" title="<%= ps.email_error || 'Delivery Error' %>">
                      <i class="fa-solid fa-circle-xmark"></i> Failed
                    </span>
                  <% } else { %>
                    <span class="badge" style="background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 9999px; font-weight: 600;">
                      <i class="fa-regular fa-clock"></i> Not Sent
                    </span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap; vertical-align: middle;">
                  <div style="display: flex; gap: 0.35rem; justify-content: flex-end; align-items: center; white-space: nowrap;">
                    <a href="/payroll/<%= ps.payroll_run_id %>/payslip/<%= ps.employee_id %>" class="btn btn-sm btn-secondary" target="_blank" style="padding: 0.25rem 0.5rem; font-size: 0.78rem; white-space: nowrap;" title="View Printable Payslip">
                      <i class="fa-regular fa-eye"></i> View
                    </a>
                    <a href="/payroll/<%= ps.payroll_run_id %>/payslip/<%= ps.employee_id %>/pdf" class="btn btn-sm btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.78rem; white-space: nowrap;" title="Download PDF">
                      <i class="fa-solid fa-file-pdf"></i> PDF
                    </a>
                    <form action="/payroll/<%= ps.payroll_run_id %>/send-email/<%= ps.employee_id %>" method="POST" style="display: inline; margin: 0; white-space: nowrap;">
                      <input type="hidden" name="redirect" value="/payslips">
                      <button type="submit" class="btn btn-sm btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.78rem; background: <%= (ps.email_status === 'Dispatched' || ps.email_status === 'Sent') ? 'linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)' : 'linear-gradient(135deg, #059669 0%, #047857 100%)' %>; border-color: #047857; white-space: nowrap;" title="<%= (ps.email_status === 'Dispatched' || ps.email_status === 'Sent') ? 'Resend Email Notification' : 'Send Email Notification' %>">
                        <i class="fa-solid <%= (ps.email_status === 'Dispatched' || ps.email_status === 'Sent') ? 'fa-rotate-right' : 'fa-paper-plane' %>"></i> <%= (ps.email_status === 'Dispatched' || ps.email_status === 'Sent') ? 'Resend' : 'Email' %>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- MOBILE CARDS VIEW (Visible on < 768px - ZERO Horizontal Scrollbar) -->
    <div class="mobile-cards-container">
      <% payslips.forEach(ps => { %>
        <% 
          const registeredEmail = ps.user_email || (ps.employee_name.toLowerCase().replace(/[^a-z0-9]/g, '') + '@hiddenlamp.com'); 
          const periodParts = (ps.period || '2026-07').split('-');
          const mNum = periodParts.length >= 2 ? String(periodParts[1]).padStart(2, '0') : '07';
          const yNameShort = periodParts[0] || '2026';
          const payslipRefNo = `HL/PS/${mNum}&#8209;${yNameShort}/${String(ps.employee_id || 1).padStart(3, '0')}`;
          const periodFormatted = `${periodParts[0]}&#8209;${mNum}`;
        %>
        <div class="mobile-payslip-card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem; box-shadow: var(--shadow-sm); margin-bottom: 0.85rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-family: monospace; font-weight: 700; background: #eff6ff; color: #1e40af; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid #bfdbfe; white-space: nowrap;">
              <%- payslipRefNo %>
            </span>
            <span class="badge badge-<%= ps.run_status === 'approved' ? 'approved' : 'draft' %>" style="font-size: 0.72rem;">
              <%= ps.run_status === 'approved' ? 'Issued' : 'Pending' %>
            </span>
          </div>

          <div style="margin-bottom: 0.75rem;">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #0f172a; margin: 0 0 0.15rem 0;"><%= ps.employee_name %></h3>
            <div style="font-size: 0.82rem; color: var(--accent); font-weight: 600;"><i class="fa-regular fa-envelope"></i> <%= registeredEmail %></div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">Pay Period: <strong><%- periodFormatted %></strong></div>
          </div>

          <div style="background: #f8fafc; border-radius: 8px; padding: 0.75rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; border: 1px solid #e2e8f0;">
            <div>
              <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Net Payable</div>
              <div style="font-size: 1.2rem; font-weight: 800; color: #2563eb;">₹<%= ps.net_pay.toLocaleString('en-IN') %></div>
            </div>
            <div style="text-align: right; font-size: 0.78rem; color: #475569;">
              Gross: <strong style="color: #059669;">₹<%= ps.gross_pay.toLocaleString('en-IN') %></strong><br>
              Deduct: <strong style="color: #dc2626;">₹<%= ps.total_deductions.toLocaleString('en-IN') %></strong>
            </div>
          </div>

          <div style="display: flex; gap: 0.4rem; justify-content: space-between; align-items: center;">
            <a href="/payroll/<%= ps.payroll_run_id %>/payslip/<%= ps.employee_id %>" class="btn btn-sm btn-secondary" target="_blank" style="flex: 1; justify-content: center; padding: 0.45rem;">
              <i class="fa-regular fa-eye"></i> View
            </a>
            <a href="/payroll/<%= ps.payroll_run_id %>/payslip/<%= ps.employee_id %>/pdf" class="btn btn-sm btn-primary" style="flex: 1; justify-content: center; padding: 0.45rem;">
              <i class="fa-solid fa-file-pdf"></i> PDF
            </a>
            <form action="/payroll/<%= ps.payroll_run_id %>/send-email/<%= ps.employee_id %>" method="POST" style="flex: 1; margin: 0; display: flex;">
              <input type="hidden" name="redirect" value="/payslips">
              <button type="submit" class="btn btn-sm btn-primary" style="width: 100%; justify-content: center; padding: 0.45rem; background: linear-gradient(135deg, #059669 0%, #047857 100%); border-color: #047857;">
                <i class="fa-regular fa-paper-plane"></i> Email
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  // Auto-refresh page once after 3.5s if email dispatch was just triggered or is currently sending
  const hasSendingBadge = document.querySelector('.fa-spinner');
  const hasSuccessAlert = document.querySelector('.alert-success');
  if (hasSendingBadge || (hasSuccessAlert && window.location.search.includes('success='))) {
    setTimeout(() => {
      // Retain search parameter if present so user stays on target employee
      window.location.reload();
    }, 3500);
  }
</script>

<%- include('../partials/footer') %>
