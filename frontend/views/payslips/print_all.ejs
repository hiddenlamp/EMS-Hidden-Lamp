<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Batch Print Payslips - Period <%= run.period %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    @page {
      size: A4 portrait;
      margin: 0 !important;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #ffffff !important;
      background-color: #ffffff !important;
      color: #1e293b;
      line-height: 1.45;
      padding: 0;
      margin: 0;
      width: 100%;
      height: 100%;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .no-print-bar {
      max-width: 210mm;
      margin: 0 auto;
      background: #0f172a;
      color: #fff;
      padding: 10px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .payslip-card {
      width: 210mm;
      max-width: 210mm;
      height: 297mm;
      min-height: 297mm;
      max-height: 297mm;
      margin: 0 auto;
      background: #ffffff !important;
      padding: 14mm 16mm;
      border: none !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      box-sizing: border-box;
      page-break-after: always;
      page-break-inside: avoid;
    }
    /* Header Section */
    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid #cbd5e1;
      margin-bottom: 18px;
    }
    .brand-container {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .logo-img {
      height: 48px;
      max-width: 150px;
      object-fit: contain;
      border-radius: 4px;
    }
    .logo-fallback {
      width: 44px;
      height: 44px;
      background: #2563eb;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }
    .company-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }
    .company-address {
      font-size: 0.82rem;
      color: #64748b;
      margin-top: 2px;
    }
    .header-period {
      text-align: right;
    }
    .header-period-sub {
      font-size: 0.82rem;
      color: #64748b;
      font-weight: 500;
    }
    .header-period-month {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }

    /* Top Grid: Summary vs Net Pay Card */
    .top-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .summary-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: #475569;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .info-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .info-table td {
      padding: 4px 0;
      vertical-align: top;
    }
    .info-table td.label {
      color: #64748b;
      width: 130px;
      font-weight: 500;
    }
    .info-table td.colon {
      width: 14px;
      color: #94a3b8;
    }
    .info-table td.value {
      color: #0f172a;
      font-weight: 700;
    }

    /* Net Pay Card (Green Accent Box) */
    .net-pay-card {
      background: #ecfdf5;
      border: 1px solid #d1fae5;
      border-radius: 10px;
      padding: 16px 20px;
    }
    .net-pay-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .net-pay-accent-bar {
      width: 4px;
      height: 36px;
      background: #10b981;
      border-radius: 2px;
    }
    .net-pay-val {
      font-size: 1.85rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
    }
    .net-pay-lbl {
      font-size: 0.78rem;
      color: #059669;
      font-weight: 600;
      margin-top: 3px;
    }
    .net-pay-divider {
      border-top: 1px solid #cbd5e1;
      margin: 8px 0;
    }
    .net-pay-days-table {
      width: 100%;
      font-size: 0.85rem;
    }
    .net-pay-days-table td {
      padding: 3px 0;
    }
    .net-pay-days-table td.lbl {
      color: #475569;
      font-weight: 500;
    }
    .net-pay-days-table td.colon {
      width: 14px;
      color: #94a3b8;
    }
    .net-pay-days-table td.val {
      font-weight: 700;
      color: #0f172a;
    }

    /* Side-by-Side Earnings & Deductions Table Box */
    .earnings-table-card {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 18px;
    }
    .dual-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .dual-table th {
      background: #ffffff;
      color: #475569;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      padding: 10px 16px;
      border-bottom: 1px solid #e2e8f0;
      text-align: left;
    }
    .dual-table th.amt { text-align: right; }
    .dual-table td {
      padding: 9px 16px;
      color: #1e293b;
      border-bottom: 1px solid #f1f5f9;
    }
    .dual-table td.amt {
      text-align: right;
      font-weight: 700;
      color: #0f172a;
    }
    .dual-table tr.summary-row td {
      background: #f8fafc;
      font-weight: 700;
      color: #0f172a;
      border-top: 1px solid #cbd5e1;
      border-bottom: none;
    }

    /* Total Net Payable Banner */
    .total-payable-banner {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      overflow: hidden;
      margin-bottom: 14px;
    }
    .total-payable-left {
      padding: 12px 20px;
    }
    .total-payable-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .total-payable-sub {
      font-size: 0.75rem;
      color: #64748b;
      margin-top: 2px;
    }
    .total-payable-right {
      background: #ecfdf5;
      padding: 14px 28px;
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      border-left: 1px solid #e2e8f0;
    }

    /* Amount in Words */
    .amount-words-row {
      text-align: right;
      font-size: 0.85rem;
      color: #475569;
      margin-bottom: 24px;
    }
    .amount-words-row strong {
      color: #0f172a;
      font-weight: 700;
    }

    /* Signatures Section */
    .signatures-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 20px;
      padding-top: 10px;
    }
    .signature-box {
      width: 220px;
    }
    .signature-space {
      height: 52px;
      display: flex;
      align-items: flex-end;
    }
    .signature-img {
      height: 52px;
      max-width: 180px;
      object-fit: contain;
    }
    .signature-line {
      border-top: 1px solid #94a3b8;
      padding-top: 5px;
      font-size: 0.78rem;
      font-weight: 600;
      color: #334155;
      text-align: center;
    }

    .footnote {
      text-align: center;
      font-size: 0.75rem;
      color: #94a3b8;
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #f1f5f9;
    }

    @media print {
      @page {
        size: A4 portrait;
        margin: 0 !important;
      }
      html, body {
        width: 210mm !important;
        height: 297mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        background-color: #ffffff !important;
        overflow: hidden !important;
      }
      .no-print-bar {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .payslip-card {
        width: 210mm !important;
        max-width: 210mm !important;
        height: 297mm !important;
        max-height: 297mm !important;
        padding: 14mm 16mm !important;
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        background: #ffffff !important;
        box-sizing: border-box !important;
        page-break-after: always;
        page-break-before: avoid !important;
        page-break-inside: avoid !important;
        overflow: hidden !important;
      }
    }
  </style>
</head>
<body>

  <% 
    function formatMonthYear(pStr) {
      if (!pStr) return 'August 2026';
      const parts = pStr.split('-');
      if (parts.length < 2) return pStr;
      const date = new Date(parts[0], parseInt(parts[1]) - 1, 1);
      return date.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    }
  %>

  <div class="no-print-bar">
    <div>
      <strong>Batch Print A4 View</strong> | Period: <%= run.period %> (<%= payslips.length %> Payslips)
    </div>
    <div>
      <button onclick="window.print()" style="background: #2563eb; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer;">🖨️ Print Batch (A4)</button>
      <button onclick="window.close()" style="background: rgba(255,255,255,0.2); color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer; margin-left: 0.5rem;">Close</button>
    </div>
  </div>

  <% payslips.forEach(ps => { %>
    <% const breakdown = ps.breakdown; %>
    <% const monthYearStr = formatMonthYear(breakdown.period); %>
    <% const empCode = breakdown.employee.employee_code || ('HL' + String(breakdown.employee.id).padStart(12, '0')); %>
    <% const paidDays = breakdown.days_present || (breakdown.days_in_month ? (breakdown.days_in_month - breakdown.days_lop) : 31); %>
    <% const lopDays = breakdown.days_lop || 0; %>

    <div class="payslip-card">
      <div>
        <!-- Header -->
        <div class="header-row">
          <div class="brand-container">
            <img src="/images/logo.png" alt="Hidden Lamp Logo" class="logo-img" onerror="this.onerror=null; this.replaceWith(document.getElementById('logo-fallback-template').content.cloneNode(true));">
            <template id="logo-fallback-template">
              <div class="logo-fallback">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              </div>
            </template>
            <div>
              <div class="company-title">Hidden Lamp Private Limited</div>
              <div class="company-address">26, UIT Pratap Nagar, Jodhpur Rajasthan, 342001 India</div>
            </div>
          </div>
          <div class="header-period">
            <div class="header-period-sub">Payslip For the Month</div>
            <div class="header-period-month"><%= monthYearStr %></div>
          </div>
        </div>

        <!-- Top Grid: Employee Summary (Left) & Net Pay Card (Right) -->
        <div class="top-grid">
          <!-- Employee Summary -->
          <div>
            <div class="summary-title">Employee Summary</div>
            <table class="info-table">
              <tr>
                <td class="label">Employee Name</td>
                <td class="colon">:</td>
                <td class="value"><%= breakdown.employee.name %></td>
              </tr>
              <tr>
                <td class="label">Employee ID</td>
                <td class="colon">:</td>
                <td class="value"><%= empCode %></td>
              </tr>
              <tr>
                <td class="label">Pay Period</td>
                <td class="colon">:</td>
                <td class="value"><%= monthYearStr %></td>
              </tr>
              <tr>
                <td class="label">Pay Date</td>
                <td class="colon">:</td>
                <td class="value"><%= breakdown.pay_date %></td>
              </tr>
            </table>
          </div>

          <!-- Net Pay Accent Card -->
          <div class="net-pay-card">
            <div class="net-pay-header">
              <div class="net-pay-accent-bar"></div>
              <div>
                <div class="net-pay-val">₹<%= breakdown.net_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                <div class="net-pay-lbl">Total Net Pay</div>
              </div>
            </div>
            <div class="net-pay-divider"></div>
            <table class="net-pay-days-table">
              <tr>
                <td class="lbl">Paid Days</td>
                <td class="colon">:</td>
                <td class="val"><%= paidDays %></td>
              </tr>
              <tr>
                <td class="lbl">LOP Days</td>
                <td class="colon">:</td>
                <td class="val"><%= lopDays %></td>
              </tr>
            </table>
          </div>
        </div>

        <!-- Side-by-Side Earnings & Deductions Table Card -->
        <div class="earnings-table-card">
          <table class="dual-table">
            <thead>
              <tr>
                <th style="width: 32%;">Earnings</th>
                <th class="amt" style="width: 18%;">Amount</th>
                <th style="width: 32%; border-left: 1px solid #e2e8f0;">Deductions</th>
                <th class="amt" style="width: 18%;">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% 
                const earnings = breakdown.earnings || [];
                const deductions = breakdown.deductions || [];
                const maxRows = Math.max(earnings.length, deductions.length, 3);
              %>
              <% for (let i = 0; i < maxRows; i++) { %>
                <% const earn = earnings[i]; %>
                <% const ded = deductions[i]; %>
                <tr>
                  <td><%= earn ? earn.name : '' %></td>
                  <td class="amt"><%= earn ? ('₹' + earn.prorated_amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '' %></td>
                  <td style="border-left: 1px solid #e2e8f0;"><%= ded ? ded.name : '' %></td>
                  <td class="amt"><%= ded ? ('₹' + ded.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : (i === 0 ? '₹0.00' : '') %></td>
                </tr>
              <% } %>
              <tr class="summary-row">
                <td>Gross Earnings</td>
                <td class="amt">₹<%= breakdown.gross_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td style="border-left: 1px solid #cbd5e1;">Total Deductions</td>
                <td class="amt">₹<%= breakdown.total_deductions.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Total Net Payable Banner -->
        <div class="total-payable-banner">
          <div class="total-payable-left">
            <div class="total-payable-title">Total Net Payable</div>
            <div class="total-payable-sub">Gross Earnings - Total Deductions</div>
          </div>
          <div class="total-payable-right">
            ₹<%= breakdown.net_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </div>
        </div>

        <!-- Amount in Words -->
        <div class="amount-words-row">
          Amount In Words : <strong><%= breakdown.net_pay_in_words %></strong>
        </div>
      </div>

      <!-- Bottom Signatures & Footer Note -->
      <div>
        <div class="signatures-row">
          <div class="signature-box">
            <div class="signature-space"></div>
            <div class="signature-line">Employee Signature</div>
          </div>
          <div class="signature-box" style="text-align: right;">
            <div class="signature-space" style="justify-content: flex-end;">
              <img src="/images/signature.png" alt="Authorized Signatory" class="signature-img" onerror="this.style.display='none';">
            </div>
            <div class="signature-line">Authorized Signatory (Hidden Lamp Pvt. Ltd.)</div>
          </div>
        </div>

        <!-- Footer Note -->
        <div class="footnote">
          -- This is a system-generated document. --
        </div>
      </div>
    </div>
  <% }); %>

</body>
</html>
