<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payslip - <%= breakdown.employee.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    @page {
      size: A4 portrait;
      margin: 0 !important;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #ffffff !important;
      background-color: #ffffff !important;
      color: #1e293b;
      line-height: 1.45;
      padding: 0;
      margin: 0;
      width: 100%;
      height: 100%;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .no-print-bar {
      max-width: 210mm;
      margin: 0 auto;
      background: #0f172a;
      color: #fff;
      padding: 10px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .payslip-card {
      width: 210mm;
      max-width: 210mm;
      height: 297mm;
      min-height: 297mm;
      max-height: 297mm;
      margin: 0 auto;
      background: #ffffff !important;
      padding: 14mm 16mm;
      border: none !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      box-sizing: border-box;
      page-break-inside: avoid;
      page-break-after: avoid;
    }
    /* Header Section */
    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid #cbd5e1;
      margin-bottom: 18px;
    }
    .brand-container {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .logo-img {
      height: 48px;
      max-width: 150px;
      object-fit: contain;
      border-radius: 4px;
    }
    .logo-fallback {
      width: 44px;
      height: 44px;
      background: #2563eb;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }
    .company-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }
    .company-address {
      font-size: 0.82rem;
      color: #64748b;
      margin-top: 2px;
    }
    .header-period {
      text-align: right;
    }
    .header-period-sub {
      font-size: 0.82rem;
      color: #64748b;
      font-weight: 500;
    }
    .header-period-month {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }
    .ref-badge {
      font-family: monospace;
      font-size: 0.82rem;
      font-weight: 700;
      color: #1e40af;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 2px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 4px;
    }

    /* Top Grid: Summary vs Net Pay Card */
    .top-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .summary-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: #475569;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .info-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .info-table td {
      padding: 4px 0;
      vertical-align: top;
    }
    .info-table td.label {
      color: #64748b;
      width: 130px;
      font-weight: 500;
    }
    .info-table td.colon {
      width: 14px;
      color: #94a3b8;
    }
    .info-table td.value {
      color: #0f172a;
      font-weight: 700;
    }

    /* Net Pay Card (Green Accent Box) */
    .net-pay-card {
      background: #ecfdf5;
      border: 1px solid #d1fae5;
      border-radius: 10px;
      padding: 16px 20px;
    }
    .net-pay-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .net-pay-accent-bar {
      width: 4px;
      height: 36px;
      background: #10b981;
      border-radius: 2px;
    }
    .net-pay-val {
      font-size: 1.85rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
    }
    .net-pay-lbl {
      font-size: 0.78rem;
      color: #059669;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 4px;
    }
    .net-pay-divider {
      height: 1px;
      background: #a7f3d0;
      margin: 12px 0 10px 0;
    }
    .net-pay-days-table {
      width: 100%;
      font-size: 0.82rem;
    }
    .net-pay-days-table td.lbl {
      color: #047857;
      font-weight: 600;
    }
    .net-pay-days-table td.colon {
      width: 12px;
      color: #10b981;
    }
    .net-pay-days-table td.val {
      color: #065f46;
      font-weight: 700;
      text-align: right;
    }

    /* Double Column Table: Earnings & Deductions */
    .tables-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 16px;
    }
    .table-section {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .section-header {
      padding: 10px 14px;
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .header-earnings {
      background: #f8fafc;
      color: #0f172a;
    }
    .header-deductions {
      background: #fff1f2;
      color: #9f1239;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }
    .breakdown-table th {
      text-align: left;
      font-size: 0.75rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      padding: 8px 14px;
      border-bottom: 1px solid #f1f5f9;
      background: #fafafa;
    }
    .breakdown-table th.amount-col {
      text-align: right;
    }
    .breakdown-table td {
      padding: 8px 14px;
      border-bottom: 1px solid #f1f5f9;
      color: #334155;
    }
    .breakdown-table td.amount-val {
      text-align: right;
      font-weight: 600;
      color: #0f172a;
    }
    .total-row td {
      background: #f8fafc;
      font-weight: 800 !important;
      color: #0f172a !important;
      border-top: 1.5px solid #cbd5e1;
      border-bottom: none;
      font-size: 0.88rem;
    }

    /* Total Net Payable Banner */
    .total-payable-banner {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      overflow: hidden;
      margin-bottom: 14px;
    }
    .total-payable-left {
      padding: 12px 20px;
    }
    .total-payable-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .total-payable-sub {
      font-size: 0.75rem;
      color: #64748b;
      margin-top: 2px;
    }
    .total-payable-right {
      background: #ecfdf5;
      padding: 14px 28px;
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      border-left: 1px solid #e2e8f0;
    }

    /* Amount in Words */
    .amount-words-row {
      text-align: right;
      font-size: 0.85rem;
      color: #475569;
      margin-bottom: 24px;
    }
    .amount-words-row strong {
      color: #0f172a;
      font-weight: 700;
    }

    /* Signatures Section */
    .signatures-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 20px;
      padding-top: 10px;
    }
    .signature-box {
      width: 220px;
    }
    .signature-space {
      height: 52px;
      display: flex;
      align-items: flex-end;
    }
    .signature-img {
      height: 52px;
      max-width: 180px;
      object-fit: contain;
    }
    .signature-line {
      border-top: 1px solid #94a3b8;
      padding-top: 5px;
      font-size: 0.78rem;
      font-weight: 700;
      color: #334155;
      text-align: center;
    }
    .footer-note {
      text-align: center;
      font-size: 0.72rem;
      color: #94a3b8;
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #f1f5f9;
    }

    @media print {
      @page {
        size: A4 portrait;
        margin: 0 !important;
      }
      html, body {
        width: 210mm !important;
        height: 297mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        background-color: #ffffff !important;
        overflow: hidden !important;
      }
      .no-print-bar {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .payslip-card {
        width: 210mm !important;
        max-width: 210mm !important;
        height: 297mm !important;
        max-height: 297mm !important;
        padding: 14mm 16mm !important;
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        background: #ffffff !important;
        box-sizing: border-box !important;
        page-break-after: avoid !important;
        page-break-before: avoid !important;
        page-break-inside: avoid !important;
        overflow: hidden !important;
      }
    }
  </style>
</head>
<body>

  <% 
    function formatMonthYear(pStr) {
      if (!pStr) return 'August 2026';
      const parts = pStr.split('-');
      if (parts.length < 2) return pStr;
      const date = new Date(parts[0], parseInt(parts[1]) - 1, 1);
      return date.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    }
    const monthYearStr = formatMonthYear(breakdown.period);
    const periodParts = (breakdown.period || '2026-07').split('-');
    const mNameShort = periodParts.length >= 2 ? new Date(periodParts[0], parseInt(periodParts[1]) - 1, 1).toLocaleString('en-US', { month: 'short' }).toUpperCase() : 'JUL';
    const yNameShort = periodParts[0] || '2026';
    const payslipRefNo = breakdown.receipt_no || `HL/PS/${mNameShort}${yNameShort}/${String(breakdown.employee.id || 1).padStart(3, '0')}`;
    const empCode = breakdown.employee.employee_code || ('HL' + String(breakdown.employee.id).padStart(12, '0'));
    const paidDays = breakdown.days_present || (breakdown.days_in_month ? (breakdown.days_in_month - breakdown.days_lop) : 31);
    const lopDays = breakdown.days_lop || 0;
    const hideTopBar = locals.isPdf || false;
  %>

  <% if (!hideTopBar) { %>
    <div class="no-print-bar">
      <div>
        <strong>A4 Payslip Preview</strong> | <%= breakdown.employee.name %> (<%= payslipRefNo %>)
      </div>
      <div>
        <button onclick="window.print()" style="background: #2563eb; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer;">🖨️ Print A4 Payslip</button>
        <button onclick="window.close()" style="background: rgba(255,255,255,0.2); color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer; margin-left: 0.5rem;">Close</button>
      </div>
    </div>
  <% } %>

  <div class="payslip-card">
    <div>
      <!-- Header -->
      <div class="header-row">
        <div class="brand-container">
          <img src="/images/logo.png" alt="Hidden Lamp Logo" class="logo-img" onerror="this.onerror=null; this.replaceWith(document.getElementById('logo-fallback-template').content.cloneNode(true));">
          <template id="logo-fallback-template">
            <div class="logo-fallback">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
          </template>
          <div>
            <div class="company-title">Hidden Lamp Private Limited</div>
            <div class="company-address">26, UIT Pratap Nagar, Jodhpur Rajasthan, 342001 India</div>
          </div>
        </div>
        <div class="header-period">
          <div class="ref-badge"><%= payslipRefNo %></div>
          <div class="header-period-sub">Payslip For the Month</div>
          <div class="header-period-month"><%= monthYearStr %></div>
        </div>
      </div>

      <!-- Top Grid: Employee Summary (Left) & Net Pay Card (Right) -->
      <div class="top-grid">
        <!-- Employee Summary -->
        <div>
          <div class="summary-title">Employee Summary</div>
          <table class="info-table">
            <tr>
              <td class="label">Reference No</td>
              <td class="colon">:</td>
              <td class="value" style="color: #2563eb;"><%= payslipRefNo %></td>
            </tr>
            <tr>
              <td class="label">Employee Name</td>
              <td class="colon">:</td>
              <td class="value"><%= breakdown.employee.name %></td>
            </tr>
            <tr>
              <td class="label">Employee ID</td>
              <td class="colon">:</td>
              <td class="value"><%= empCode %></td>
            </tr>
            <tr>
              <td class="label">Pay Period</td>
              <td class="colon">:</td>
              <td class="value"><%= monthYearStr %></td>
            </tr>
            <tr>
              <td class="label">Pay Date</td>
              <td class="colon">:</td>
              <td class="value"><%= breakdown.pay_date %></td>
            </tr>
          </table>
        </div>

        <!-- Net Pay Accent Card -->
        <div class="net-pay-card">
          <div class="net-pay-header">
            <div class="net-pay-accent-bar"></div>
            <div>
              <div class="net-pay-val">₹<%= breakdown.net_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
              <div class="net-pay-lbl">Total Net Pay</div>
            </div>
          </div>
          <div class="net-pay-divider"></div>
          <table class="net-pay-days-table">
            <tr>
              <td class="lbl">Paid Days</td>
              <td class="colon">:</td>
              <td class="val"><%= paidDays %></td>
            </tr>
            <tr>
              <td class="lbl">LOP Days</td>
              <td class="colon">:</td>
              <td class="val"><%= lopDays %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Breakdown Grid: Earnings & Deductions -->
      <div class="tables-container">
        <!-- EARNINGS TABLE -->
        <div class="table-section">
          <div class="section-header header-earnings">
            <span>EARNINGS</span>
            <span>AMOUNT (₹)</span>
          </div>
          <table class="breakdown-table">
            <thead>
              <tr>
                <th>Component</th>
                <th class="amount-col">Monthly Fixed</th>
              </tr>
            </thead>
            <tbody>
              <% if (breakdown.earnings && breakdown.earnings.length > 0) { %>
                <% breakdown.earnings.forEach(item => { %>
                  <% const itemVal = typeof item.amount !== 'undefined' ? item.amount : (typeof item.prorated_amount !== 'undefined' ? item.prorated_amount : (item.base_amount || 0)); %>
                  <tr>
                    <td><%= item.name %></td>
                    <td class="amount-val">₹<%= Number(itemVal).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td>Basic Salary</td>
                  <td class="amount-val">₹<%= (breakdown.gross_pay || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                </tr>
              <% } %>
              <tr class="total-row">
                <td>Total Gross Earnings</td>
                <td class="amount-val">₹<%= breakdown.gross_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- DEDUCTIONS TABLE -->
        <div class="table-section">
          <div class="section-header header-deductions">
            <span>DEDUCTIONS</span>
            <span>AMOUNT (₹)</span>
          </div>
          <table class="breakdown-table">
            <thead>
              <tr>
                <th>Component</th>
                <th class="amount-col">Deducted</th>
              </tr>
            </thead>
            <tbody>
              <% if (breakdown.deductions && breakdown.deductions.length > 0) { %>
                <% breakdown.deductions.forEach(item => { %>
                  <% const itemVal = typeof item.amount !== 'undefined' ? item.amount : (typeof item.prorated_amount !== 'undefined' ? item.prorated_amount : (item.base_amount || 0)); %>
                  <tr>
                    <td><%= item.name %></td>
                    <td class="amount-val">₹<%= Number(itemVal).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td style="color: var(--text-muted);">No Deductions</td>
                  <td class="amount-val">₹0.00</td>
                </tr>
              <% } %>
              <tr class="total-row">
                <td>Total Deductions</td>
                <td class="amount-val" style="color: #dc2626 !important;">₹<%= breakdown.total_deductions.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Total Net Payable Banner -->
      <div class="total-payable-banner">
        <div class="total-payable-left">
          <div class="total-payable-title">TOTAL NET PAYABLE</div>
          <div class="total-payable-sub">Gross Earnings minus Total Deductions</div>
        </div>
        <div class="total-payable-right">
          ₹<%= breakdown.net_pay.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </div>
      </div>

      <!-- Amount in Words -->
      <div class="amount-words-row">
        Amount in Words: <strong><%= breakdown.net_pay_words || 'Rupees Only' %></strong>
      </div>
    </div>

    <!-- Signatures & Footer Note -->
    <div>
      <div class="signatures-row">
        <div class="signature-box">
          <div class="signature-space"></div>
          <div class="signature-line">Employer Signature</div>
        </div>
        <div class="signature-box">
          <div class="signature-space">
            <img src="/images/signature.png" alt="Authorized Signatory" class="signature-img" onerror="this.style.display='none';">
          </div>
          <div class="signature-line">Authorized Signatory</div>
        </div>
      </div>
      <div class="footer-note">
        This is a computer-generated document. No physical signature is required. | Reference: <strong><%= payslipRefNo %></strong>
      </div>
    </div>
  </div>

</body>
</html>
